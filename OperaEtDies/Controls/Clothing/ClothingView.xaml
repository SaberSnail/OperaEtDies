<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Clothing"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A piece of clothing: its short description, why it can't be worn (if anything keeps it from being worn), and what it
		looks like, while it's being examined. The buttons beside it are given by the list it's in.  -->
	<DataTemplate x:Key="ClothingPieceTemplate" DataType="{x:Type local:ClothingPieceViewModel}">
		<StackPanel>
			<TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
			<TextBlock
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding Note}"
				TextWrapping="Wrap"
				Visibility="{Binding Note, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<StackPanel Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<TextBlock
					Margin="0,4,0,0"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding LongDescription}"
					TextWrapping="Wrap" />
				<!--  For developers, how much of each region the piece covers, and its bulk.  -->
				<Border
					Margin="0,4,0,0"
					HorizontalAlignment="Left"
					Style="{DynamicResource DeveloperBorderStyle}"
					Visibility="{Binding DeveloperCoverage, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
					<TextBlock Text="{Binding DeveloperCoverage}" TextWrapping="Wrap" />
				</Border>
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<Style x:Key="ClothingButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="96" />
		<Setter Property="Height" Value="28" />
		<Setter Property="Margin" Value="8,0,0,0" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

	<Style x:Key="ClothingHeaderStyle" TargetType="TextBlock">
		<Setter Property="Margin" Value="0,16,0,8" />
		<Setter Property="FontSize" Value="{DynamicResource LargeFontSize}" />
		<Setter Property="FontWeight" Value="Bold" />
	</Style>

	<Style x:Key="ClothingNoneStyle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="Text" Value="{x:Static operaEtDies:OurResources.ClothingNone}" />
	</Style>

	<!--  The player's inventory or wardrobe, in a sheet, whose frame has the title and the close button. The wardrobe also has
		the player's outfits, and the clothes they keep at home.  -->
	<DataTemplate DataType="{x:Type local:ClothingScreenViewModel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!--  Which parts of the body the player must cover more before they can leave, which keeps the sheet from closing. It's
				hidden rather than removed while they're dressed enough, so the lists don't move when it appears. For developers, how
				modest the player is in each region their modesty rule checks.  -->
			<StackPanel Grid.Row="0">
				<Border
					Padding="8,4"
					HorizontalAlignment="Left"
					Background="{DynamicResource AccentBrush}"
					Visibility="{Binding HasWarning, Converter={x:Static utility:CommonConverters.BooleanToVisibilityWithHidden}}">
					<TextBlock
						FontWeight="Bold"
						Foreground="{DynamicResource TextOnAccentBrush}"
						Text="{Binding Warning}"
						TextWrapping="Wrap" />
				</Border>
				<Border
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Style="{DynamicResource DeveloperBorderStyle}"
					Visibility="{Binding IsDeveloper, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Text="{Binding DeveloperModesty}" TextWrapping="Wrap" />
				</Border>
			</StackPanel>

			<ScrollViewer
				Grid.Row="1"
				Margin="0,4,0,0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<!--  In the wardrobe, the outfits the player can change into, ending with nothing at all.  -->
					<StackPanel Visibility="{Binding IsWardrobe, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock Style="{StaticResource ClothingHeaderStyle}" Text="{x:Static operaEtDies:OurResources.ClothingOutfitsHeader}" />
						<ItemsControl ItemsSource="{Binding Outfits}">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:OutfitViewModel}">
									<DockPanel Margin="0,0,0,8" LastChildFill="True">
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ChangeInto}"
											Content="{x:Static operaEtDies:OurResources.OutfitChangeInto}"
											DockPanel.Dock="Right"
											Style="{StaticResource ClothingButtonStyle}" />
										<TextBlock
											Width="160"
											FontWeight="Bold"
											Text="{Binding Title}"
											TextTrimming="CharacterEllipsis" />
										<StackPanel>
											<TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
											<TextBlock
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding Note}"
												Visibility="{Binding Note, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
										</StackPanel>
									</DockPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<!--  What the player is wearing.  -->
					<TextBlock Style="{StaticResource ClothingHeaderStyle}" Text="{x:Static operaEtDies:OurResources.ClothingWearingHeader}" />
					<TextBlock Style="{StaticResource ClothingNoneStyle}" Visibility="{Binding IsNothingWorn, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
					<ItemsControl ItemsSource="{Binding Wearing}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:ClothingPieceViewModel}">
								<DockPanel Margin="0,0,0,8" LastChildFill="True">
									<Button
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=TakeOff}"
										Content="{x:Static operaEtDies:OurResources.ClothingTakeOff}"
										DockPanel.Dock="Right"
										Style="{StaticResource ClothingButtonStyle}" />
									<Button
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
										Content="{x:Static operaEtDies:OurResources.ClothingExamine}"
										DockPanel.Dock="Right"
										Style="{StaticResource ClothingButtonStyle}" />
									<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ClothingPieceTemplate}" Focusable="False" />
								</DockPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  What the player is carrying, which they can put away at home.  -->
					<TextBlock Style="{StaticResource ClothingHeaderStyle}" Text="{x:Static operaEtDies:OurResources.ClothingCarryingHeader}" />
					<TextBlock Style="{StaticResource ClothingNoneStyle}" Visibility="{Binding IsNothingCarried, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
					<!--  Bundles the player carries for their steps, which only their steps can put down.  -->
					<ItemsControl ItemsSource="{Binding Bundles}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:BundleViewModel}">
								<StackPanel Margin="0,0,0,8">
									<TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
									<TextBlock
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Note}"
										TextWrapping="Wrap"
										Visibility="{Binding Note, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<ItemsControl ItemsSource="{Binding Carrying}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:ClothingPieceViewModel}">
								<DockPanel Margin="0,0,0,8" LastChildFill="True">
									<Button
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=PutAway}"
										Content="{x:Static operaEtDies:OurResources.ClothingPutAway}"
										DockPanel.Dock="Right"
										Style="{StaticResource ClothingButtonStyle}" />
									<Button
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Wear}"
										Content="{x:Static operaEtDies:OurResources.ClothingWear}"
										DockPanel.Dock="Right"
										Style="{StaticResource ClothingButtonStyle}" />
									<Button
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
										Content="{x:Static operaEtDies:OurResources.ClothingExamine}"
										DockPanel.Dock="Right"
										Style="{StaticResource ClothingButtonStyle}" />
									<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ClothingPieceTemplate}" Focusable="False" />
								</DockPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  In the wardrobe, the player's own clothes kept at home.  -->
					<StackPanel Visibility="{Binding IsWardrobe, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock Style="{StaticResource ClothingHeaderStyle}" Text="{x:Static operaEtDies:OurResources.ClothingKeptAtHomeHeader}" />
						<TextBlock Style="{StaticResource ClothingNoneStyle}" Visibility="{Binding IsNothingKeptAtHome, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
						<ItemsControl ItemsSource="{Binding KeptAtHome}">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:ClothingPieceViewModel}">
									<DockPanel Margin="0,0,0,8" LastChildFill="True">
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Take}"
											Content="{x:Static operaEtDies:OurResources.ClothingTake}"
											DockPanel.Dock="Right"
											Style="{StaticResource ClothingButtonStyle}" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Wear}"
											Content="{x:Static operaEtDies:OurResources.ClothingWear}"
											DockPanel.Dock="Right"
											Style="{StaticResource ClothingButtonStyle}" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
											Content="{x:Static operaEtDies:OurResources.ClothingExamine}"
											DockPanel.Dock="Right"
											Style="{StaticResource ClothingButtonStyle}" />
										<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ClothingPieceTemplate}" Focusable="False" />
									</DockPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</DataTemplate>

</ResourceDictionary>
