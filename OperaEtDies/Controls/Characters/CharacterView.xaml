<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Characters"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A relationship: the other person's name, what it's called (in bold for a friend), and for developers, a slider that changes
		its score, with the score beside it.  -->
	<DataTemplate x:Key="CharacterRelationshipTemplate" DataType="{x:Type local:CharacterRelationshipViewModel}">
		<Grid Margin="0,0,0,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="220" />
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				Text="{Binding Name}"
				TextTrimming="CharacterEllipsis" />
			<TextBlock Grid.Column="1" Text="{Binding Level}">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsFriend}" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
								<Setter Property="FontWeight" Value="Bold" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
			<Border
				Grid.Column="2"
				Style="{DynamicResource DeveloperBorderStyle}"
				Visibility="{Binding IsDeveloper, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<StackPanel Orientation="Horizontal">
					<Slider
						Width="200"
						VerticalAlignment="Center"
						IsSnapToTickEnabled="True"
						Maximum="100"
						Minimum="0"
						TickFrequency="1"
						Value="{Binding Score}" />
					<TextBlock
						Width="32"
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						Text="{Binding Score}"
						TextAlignment="Right" />
				</StackPanel>
			</Border>
		</Grid>
	</DataTemplate>

	<!--  The sheet for one person, whose title is their name: how they're related to the player, what they're doing, their
		portrait beside their description, their relationships if they're the player, and for developers, a way to their
		needs, where they're going and why, everyone's relationships, and who they've seen lately.  -->
	<DataTemplate DataType="{x:Type local:CharacterViewModel}">
		<DockPanel>
			<!--  For developers, a way to see and change the person's needs.  -->
			<Border
				Margin="0,0,0,12"
				HorizontalAlignment="Left"
				DockPanel.Dock="Top"
				Style="{DynamicResource DeveloperBorderStyle}"
				Visibility="{Binding CanViewStatus, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<Button
					Width="120"
					Height="32"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ViewStatus}"
					Content="{x:Static operaEtDies:OurResources.ViewPersonStatus}" />
			</Border>

			<ScrollViewer
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<StackPanel DataContext="{Binding Person}">
						<TextBlock
							Margin="0,0,0,4"
							FontStyle="Italic"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding PlayerLabel}"
							Visibility="{Binding PlayerLabel, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
						<TextBlock
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding Activity}"
							Visibility="{Binding Activity, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />

						<!--  For developers, where the person is going and why they chose to.  -->
						<Border
							Margin="0,8,0,0"
							Style="{DynamicResource DeveloperBorderStyle}"
							Visibility="{Binding DeveloperGoal, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
							<StackPanel>
								<TextBlock Text="{Binding DeveloperGoal}" TextWrapping="Wrap" />
								<TextBlock
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding DeveloperGoalReason}"
									TextWrapping="Wrap" />
							</StackPanel>
						</Border>

						<DockPanel Margin="0,12,0,0" LastChildFill="True">
							<Image
								Width="200"
								Margin="0,0,12,0"
								VerticalAlignment="Top"
								DockPanel.Dock="Left"
								Source="{Binding Portrait}"
								Stretch="Uniform"
								Visibility="{Binding Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
							<TextBlock
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding Person.Description}"
								TextWrapping="Wrap" />
						</DockPanel>
					</StackPanel>

					<!--  The player's own boldness, with a slider for developers that changes it, or for developers, anyone's.  -->
					<StackPanel Margin="0,12,0,0" Visibility="{Binding IsBoldnessShown, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock Text="{Binding BoldnessText}" />
						<Border
							Margin="0,4,0,0"
							HorizontalAlignment="Left"
							Style="{DynamicResource DeveloperBorderStyle}"
							Visibility="{Binding CanChangeBoldness, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
							<Slider
								Width="200"
								VerticalAlignment="Center"
								IsSnapToTickEnabled="True"
								Maximum="{Binding BoldnessMaximum}"
								Minimum="{Binding BoldnessMinimum}"
								TickFrequency="1"
								Value="{Binding Boldness}" />
						</Border>
					</StackPanel>
					<Border
						Margin="0,12,0,0"
						HorizontalAlignment="Left"
						Style="{DynamicResource DeveloperBorderStyle}"
						Visibility="{Binding IsBoldnessDeveloperOnly, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock Text="{Binding BoldnessText}" />
					</Border>

					<!--  The player's own relationships, or for developers, anyone's.  -->
					<StackPanel Visibility="{Binding IsRelationshipsShown, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock
							Margin="0,16,0,8"
							FontSize="{DynamicResource LargeFontSize}"
							FontWeight="Bold"
							Text="{x:Static operaEtDies:OurResources.RelationshipsHeader}" />
						<ItemsControl ItemTemplate="{StaticResource CharacterRelationshipTemplate}" ItemsSource="{Binding Relationships}" />
					</StackPanel>
					<Border
						Margin="0,16,0,0"
						HorizontalAlignment="Left"
						Style="{DynamicResource DeveloperBorderStyle}"
						Visibility="{Binding IsRelationshipsDeveloperOnly, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<StackPanel>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="{DynamicResource LargeFontSize}"
								FontWeight="Bold"
								Text="{x:Static operaEtDies:OurResources.RelationshipsHeader}" />
							<ItemsControl ItemTemplate="{StaticResource CharacterRelationshipTemplate}" ItemsSource="{Binding Relationships}" />
						</StackPanel>
					</Border>

					<!--  For developers, who the person has seen lately.  -->
					<Border
						Margin="0,16,0,0"
						HorizontalAlignment="Left"
						Style="{DynamicResource DeveloperBorderStyle}"
						Visibility="{Binding Sightings, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
						<StackPanel>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="{DynamicResource LargeFontSize}"
								FontWeight="Bold"
								Text="{x:Static operaEtDies:OurResources.SightingsHeader}" />
							<TextBlock
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{x:Static operaEtDies:OurResources.SightingsNone}"
								Visibility="{Binding IsSightingsEmpty, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
							<ItemsControl ItemsSource="{Binding Sightings}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock
											Margin="0,0,0,4"
											Text="{Binding}"
											TextWrapping="Wrap" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>
	</DataTemplate>

</ResourceDictionary>
