<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:GoldenAnvil.Utility.Windows.Controls;assembly=GoldenAnvil.Utility.Windows"
	xmlns:local="clr-namespace:OperaEtDies.Controls.NewGame"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<DataTemplate DataType="{x:Type local:NewGameViewModel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource TitleFontSize}"
				Text="{x:Static operaEtDies:OurResources.NewGameHeader}" />

			<Grid
				Grid.Row="1"
				Width="360"
				Margin="0,16,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">
				<Grid.Resources>
					<Style x:Key="LabelStyle" TargetType="TextBlock">
						<Setter Property="Margin" Value="0,0,12,0" />
						<Setter Property="VerticalAlignment" Value="Center" />
					</Style>
				</Grid.Resources>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.ProfessionLabel}" />
				<ComboBox
					Grid.Row="0"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					DisplayMemberPath="Title"
					ItemsSource="{Binding Professions}"
					SelectedItem="{Binding Profession}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.FirstNameLabel}" />
				<controls:CustomTextBox
					Grid.Row="2"
					Grid.Column="1"
					VerticalContentAlignment="Center"
					Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
				<Button
					Grid.Row="2"
					Grid.Column="2"
					Margin="8,0,0,0"
					Padding="8,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeFirstName}"
					Content="{x:Static operaEtDies:OurResources.RandomFirstName}" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.LastNameLabel}" />
				<!--  Last name updates when focus leaves, so a blank name can be replaced with the profession's default.  -->
				<controls:CustomTextBox
					Grid.Row="4"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					VerticalContentAlignment="Center"
					Text="{Binding LastName}" />

				<TextBlock
					Grid.Row="6"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.HeightLabel}" />
				<ComboBox
					Grid.Row="6"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					DisplayMemberPath="Title"
					ItemsSource="{Binding Heights}"
					SelectedItem="{Binding Height}" />

				<TextBlock
					Grid.Row="8"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.WeightLabel}" />
				<ComboBox
					Grid.Row="8"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					DisplayMemberPath="Title"
					ItemsSource="{Binding Weights}"
					SelectedItem="{Binding Weight}" />

				<TextBlock
					Grid.Row="10"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.AgeLabel}" />
				<!--  Age updates when focus leaves, so values below the minimum can be typed on the way to a valid age.  -->
				<controls:CustomTextBox
					Grid.Row="10"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					VerticalContentAlignment="Center"
					Text="{Binding Age}" />
			</Grid>

			<StackPanel
				Grid.Row="2"
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					Width="120"
					Height="32"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Back}"
					Content="{x:Static operaEtDies:OurResources.Back}"
					IsCancel="True" />
				<Button
					Width="120"
					Height="32"
					Margin="8,0,0,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=StartGame}"
					Content="{x:Static operaEtDies:OurResources.StartGame}" />
			</StackPanel>
		</Grid>
	</DataTemplate>

</ResourceDictionary>
