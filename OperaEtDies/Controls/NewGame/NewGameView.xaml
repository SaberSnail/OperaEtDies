<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:GoldenAnvil.Utility.Windows.Controls;assembly=GoldenAnvil.Utility.Windows"
	xmlns:local="clr-namespace:OperaEtDies.Controls.NewGame"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<DataTemplate DataType="{x:Type local:NewGameViewModel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource TitleFontSize}"
				Text="{x:Static operaEtDies:OurResources.NewGameHeader}" />

			<Grid
				Grid.Row="1"
				Width="360"
				Margin="0,16,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">
				<Grid.Resources>
					<Style x:Key="LabelStyle" TargetType="TextBlock">
						<Setter Property="Margin" Value="0,0,12,0" />
						<Setter Property="VerticalAlignment" Value="Center" />
					</Style>
					<Style x:Key="RandomizeButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
						<Setter Property="Margin" Value="8,0,0,0" />
						<Setter Property="Padding" Value="8,0" />
						<Setter Property="Content" Value="{x:Static operaEtDies:OurResources.RandomizeField}" />
					</Style>
				</Grid.Resources>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
					<RowDefinition Height="8" />
					<RowDefinition Height="28" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.ProfessionLabel}" />
				<ComboBox
					Grid.Row="0"
					Grid.Column="1"
					DisplayMemberPath="Title"
					ItemsSource="{Binding Professions}"
					SelectedItem="{Binding Profession}" />
				<Button
					Grid.Row="0"
					Grid.Column="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeProfession}"
					Style="{StaticResource RandomizeButtonStyle}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.FirstNameLabel}" />
				<!--  First name updates when focus leaves, so a blank name can be replaced with a random one.  -->
				<controls:CustomTextBox
					Grid.Row="2"
					Grid.Column="1"
					VerticalContentAlignment="Center"
					Text="{Binding FirstName}" />
				<Button
					Grid.Row="2"
					Grid.Column="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeFirstName}"
					Style="{StaticResource RandomizeButtonStyle}" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.LastNameLabel}" />
				<!--  Last name updates when focus leaves, so a blank name can be replaced with the profession's default.  -->
				<controls:CustomTextBox
					Grid.Row="4"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					VerticalContentAlignment="Center"
					Text="{Binding LastName}" />

				<TextBlock
					Grid.Row="6"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.HeightLabel}" />
				<ComboBox
					Grid.Row="6"
					Grid.Column="1"
					DisplayMemberPath="Title"
					ItemsSource="{Binding Heights}"
					SelectedItem="{Binding Height}" />
				<Button
					Grid.Row="6"
					Grid.Column="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeHeight}"
					Style="{StaticResource RandomizeButtonStyle}" />

				<TextBlock
					Grid.Row="8"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.WeightLabel}" />
				<ComboBox
					Grid.Row="8"
					Grid.Column="1"
					DisplayMemberPath="Title"
					ItemsSource="{Binding Weights}"
					SelectedItem="{Binding Weight}" />
				<Button
					Grid.Row="8"
					Grid.Column="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeWeight}"
					Style="{StaticResource RandomizeButtonStyle}" />

				<TextBlock
					Grid.Row="10"
					Grid.Column="0"
					Style="{StaticResource LabelStyle}"
					Text="{x:Static operaEtDies:OurResources.AgeLabel}" />
				<!--  Age updates when focus leaves, so values outside the allowed range can be typed on the way to a valid age, and a blank age can be replaced with a random one.  -->
				<controls:CustomTextBox
					Grid.Row="10"
					Grid.Column="1"
					VerticalContentAlignment="Center"
					Text="{Binding AgeText}" />
				<Button
					Grid.Row="10"
					Grid.Column="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeAge}"
					Style="{StaticResource RandomizeButtonStyle}" />
			</Grid>

			<Grid Grid.Row="2">
				<Grid.Resources>
					<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
						<Setter Property="Width" Value="120" />
						<Setter Property="Height" Value="32" />
					</Style>
				</Grid.Resources>

				<Button
					HorizontalAlignment="Left"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Back}"
					Content="{x:Static operaEtDies:OurResources.Back}"
					IsCancel="True" />
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RandomizeAll}"
						Content="{x:Static operaEtDies:OurResources.RandomizeAll}" />
					<Button
						Margin="8,0,0,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=StartGame}"
						Content="{x:Static operaEtDies:OurResources.StartGame}" />
				</StackPanel>
			</Grid>
		</Grid>
	</DataTemplate>

</ResourceDictionary>
