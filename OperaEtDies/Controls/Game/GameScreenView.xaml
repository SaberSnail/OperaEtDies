<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:layout="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Game"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A need as its icon over a short bar, with what it shows in words in its tooltip: the player's needs in the left
		column, and their household's chores in Concerns. A need at its worst level is drawn as a threat, a chore that's done
		for the day or week in the accent color with a check mark, and one that can't be done today is muted.  -->
	<DataTemplate DataType="{x:Type local:MeterViewModel}">
		<StackPanel
			x:Name="Meter"
			Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=2.1}"
			Margin="0,0,0,4"
			Background="Transparent"
			ToolTip="{Binding ToolTip}"
			ToolTipService.ShowOnDisabled="True">
			<Grid HorizontalAlignment="Center">
				<Viewbox Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.4}" Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.4}">
					<Canvas Width="24" Height="24">
						<Path
							x:Name="IconPath"
							Data="{Binding Icon}"
							Stroke="{DynamicResource TextBrush}"
							StrokeEndLineCap="Round"
							StrokeLineJoin="Round"
							StrokeStartLineCap="Round"
							StrokeThickness="1.6" />
					</Canvas>
				</Viewbox>
				<Viewbox
					x:Name="Check"
					Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=0.7}"
					Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=0.7}"
					Margin="0,-2,-8,0"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Visibility="Collapsed">
					<Canvas Width="24" Height="24">
						<Path
							Data="{StaticResource CheckIcon}"
							Stroke="{DynamicResource AccentBrush}"
							StrokeEndLineCap="Round"
							StrokeLineJoin="Round"
							StrokeStartLineCap="Round"
							StrokeThickness="3.5" />
					</Canvas>
				</Viewbox>
			</Grid>
			<ProgressBar
				x:Name="Bar"
				Height="4"
				Margin="0,3,0,0"
				Value="{Binding Fraction, Mode=OneWay}" />
		</StackPanel>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding IsWarning}" Value="True">
				<Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource ThreatBrush}" />
				<Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource ThreatBrush}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsComplete}" Value="True">
				<Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource AccentBrush}" />
				<Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource AccentBrush}" />
				<Setter TargetName="Check" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsActive}" Value="False">
				<Setter TargetName="Meter" Property="Opacity" Value="0.45" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<!--  Needs or chores as icons, wrapping onto as many rows as the column's width needs.  -->
	<ItemsPanelTemplate x:Key="MeterPanelTemplate">
		<WrapPanel />
	</ItemsPanelTemplate>

	<!--  A chore in Concerns as a button that starts it. It only looks like its icon, with the usual hover, since its icon
		shows whether it's done or can't be done today, and its tooltip why it can't be started now.  -->
	<Style x:Key="MeterButtonStyle" TargetType="{x:Type Button}">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisualStyle}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Margin" Value="0,0,2,2" />
		<Setter Property="Padding" Value="0,3,0,0" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						CornerRadius="{DynamicResource ControlBorderRadius}">
						<ContentPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsMouseOver" Value="True" />
					<Condition Property="IsEnabled" Value="True" />
				</MultiTrigger.Conditions>
				<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
			</MultiTrigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  The left column: the player's portrait, name, and profession, the date and time with the day dial, their next
		appointment, their needs as icons, and the mini-map. In compact mode, the portrait is smaller, and the mini-map is as
		wide as the column. The column scrolls when it doesn't all fit.  -->
	<DataTemplate DataType="{x:Type local:CharacterPanelViewModel}">
		<ScrollViewer
			Focusable="False"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="12">
				<!--  The portrait in a frame, and the name and profession under it. The portrait art draws its own background, so
					the frame's mat can follow the palette.  -->
				<Border
					HorizontalAlignment="Center"
					Padding="4"
					Background="{DynamicResource InsetBrush}"
					BorderBrush="{DynamicResource RuleBrush}"
					BorderThickness="1"
					CornerRadius="2"
					Visibility="{Binding Player.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
					<Image Source="{Binding Player.Portrait}" Stretch="Uniform">
						<Image.Style>
							<Style TargetType="Image">
								<Setter Property="Width" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=8.5}" />
								<Style.Triggers>
									<Trigger Property="layout:ColumnLayout.IsCompact" Value="True">
										<Setter Property="Width" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=4.5}" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</Image.Style>
					</Image>
				</Border>
				<TextBlock
					Margin="0,8,0,0"
					FontSize="{DynamicResource LargeFontSize}"
					Text="{Binding Player.Name}"
					TextAlignment="Center"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding Player.Name}" />
				<TextBlock
					FontStyle="Italic"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding Profession}"
					TextAlignment="Center"
					TextTrimming="CharacterEllipsis"
					Visibility="{Binding Profession, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />

				<!--  The date, any festival or other special day, the time of day with the day dial, and the next appointment.
					The appointment's line is kept when there's none, so nothing below it moves.  -->
				<TextBlock Style="{DynamicResource CaptionTextStyle}" Text="{Binding Date}" />
				<TextBlock
					Margin="0,0,0,2"
					FontWeight="SemiBold"
					Text="{Binding SpecialDay}"
					TextWrapping="Wrap"
					Visibility="{Binding SpecialDay, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				<DockPanel>
					<local:DayDial
						Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=2.4}"
						Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.3}"
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Left"
						IsNight="{Binding IsNight}"
						Marks="{Binding DayDialMarks}"
						MoonBrush="{DynamicResource PanelBrush}"
						Position="{Binding DayDialPosition}"
						Stroke="{DynamicResource TextBrush}"
						SunBrush="{DynamicResource SunBrush}" />
					<TextBlock VerticalAlignment="Center" Text="{Binding TimeOfDay}" />
				</DockPanel>
				<TextBlock
					Margin="0,4,0,0"
					FontSize="{DynamicResource SmallFontSize}"
					Text="{Binding NextAppointment}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding NextAppointment}" />

				<!--  How well the player's needs are met, as icons.  -->
				<TextBlock Style="{DynamicResource CaptionTextStyle}" Text="{x:Static operaEtDies:OurResources.NeedsHeader}" />
				<ItemsControl
					Focusable="False"
					ItemsPanel="{StaticResource MeterPanelTemplate}"
					ItemsSource="{Binding Needs}" />

				<TextBlock Style="{DynamicResource CaptionTextStyle}" Text="{x:Static operaEtDies:OurResources.MiniMapHeader}" />

				<!--  The player's quarter and the quarters its paths lead to, at most 10 ems wide.  -->
				<Viewbox MaxWidth="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=10}" Stretch="Uniform">
					<Border
						Width="204"
						Height="204"
						BorderBrush="{DynamicResource RuleBrush}"
						BorderThickness="1">
						<ContentControl
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Content="{Binding MiniMap}"
							ContentTemplate="{DynamicResource TownMapCanvasTemplate}"
							Focusable="False" />
					</Border>
				</Viewbox>
			</StackPanel>
		</ScrollViewer>
	</DataTemplate>

	<!--  The Concerns panel: what the player should keep in mind. Its buttons can take keyboard focus, which J moves here.
		For now, that's the player's work, with how much is done and a button that starts it, their household's chores as
		icons that start them, where they're heading, with a button that clears it (and while choosing a new destination
		would give up what they're doing, the question whether to), and today's appointments still to come, each with a
		button that makes its place the destination. The work and chores are always there, so they come first, and the parts
		that come and go are below them.  -->
	<DataTemplate DataType="{x:Type local:ConcernsViewModel}">
		<ScrollViewer
			Focusable="False"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="12,12,12,8">
				<TextBlock
					Margin="0,0,0,4"
					Style="{DynamicResource CaptionTextStyle}"
					Text="{x:Static operaEtDies:OurResources.ConcernsHeader}" />
				<!--  The player's work: its title and how much is done beside its icon, with a button that starts it. Why it can't be
					started now is the button's tooltip, so nothing moves when that changes.  -->
				<ItemsControl Focusable="False" ItemsSource="{Binding Work}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:ConcernsWorkViewModel}">
							<DockPanel Margin="0,0,0,8">
								<Button
									Margin="8,0,0,0"
									Padding="8,2"
									VerticalAlignment="Center"
									Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Start}"
									Content="{Binding StartText}"
									DockPanel.Dock="Right"
									IsEnabled="{Binding IsStartable}"
									ToolTip="{Binding Note}"
									ToolTipService.ShowOnDisabled="True" />
								<Viewbox
									Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.4}"
									Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.4}"
									Margin="0,0,8,0"
									VerticalAlignment="Center"
									DockPanel.Dock="Left">
									<Canvas Width="24" Height="24">
										<Path
											x:Name="IconPath"
											Data="{Binding Icon}"
											Stroke="{DynamicResource TextBrush}"
											StrokeEndLineCap="Round"
											StrokeLineJoin="Round"
											StrokeStartLineCap="Round"
											StrokeThickness="1.6" />
									</Canvas>
								</Viewbox>
								<StackPanel VerticalAlignment="Center">
									<TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
									<TextBlock
										FontSize="{DynamicResource SmallFontSize}"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Status}"
										TextWrapping="Wrap" />
								</StackPanel>
							</DockPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding IsComplete}" Value="True">
									<Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource AccentBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  The household's chores, as icons that start them.  -->
				<StackPanel Margin="0,0,0,8" Visibility="{Binding Household, Converter={x:Static utility:CommonConverters.IsNullOrEmptyToVisibility}}">
					<TextBlock Margin="0,0,0,2" Text="{x:Static operaEtDies:OurResources.HouseholdHeader}" />
					<ItemsControl
						Focusable="False"
						ItemsPanel="{StaticResource MeterPanelTemplate}"
						ItemsSource="{Binding Household}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:MeterViewModel}">
								<Button
									Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Start}"
									Content="{Binding}"
									IsEnabled="{Binding IsStartable}"
									Style="{StaticResource MeterButtonStyle}"
									ToolTip="{Binding ToolTip}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<TextBlock Text="{x:Static operaEtDies:OurResources.ConcernsDestinationHeader}" />
				<DockPanel Margin="0,2,0,0">
					<Button
						Padding="2"
						VerticalAlignment="Center"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ClearDestination}"
						Content="{StaticResource CloseIcon}"
						DockPanel.Dock="Right"
						Focusable="True"
						Style="{StaticResource IconButtonStyle}"
						ToolTip="{x:Static operaEtDies:OurResources.ConcernsClearDestinationToolTip}" />
					<TextBlock Text="{Binding Destination}" TextWrapping="Wrap">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasDestination}" Value="False">
										<Setter Property="FontStyle" Value="Italic" />
										<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</DockPanel>
				<StackPanel Margin="0,4,0,0" Visibility="{Binding IsAskingDestination, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Text="{Binding DestinationQuestion}" TextWrapping="Wrap" />
					<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
						<Button
							Padding="8,2"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ConfirmDestination}"
							Content="{x:Static operaEtDies:OurResources.ConcernsDestinationConfirm}" />
						<Button
							Margin="8,0,0,0"
							Padding="8,2"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CancelDestination}"
							Content="{x:Static operaEtDies:OurResources.ConcernsDestinationCancel}" />
					</StackPanel>
				</StackPanel>
				<TextBlock Margin="0,8,0,0" Text="{x:Static operaEtDies:OurResources.ConcernsAppointmentsHeader}" />
				<TextBlock
					Margin="0,2,0,0"
					FontStyle="Italic"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{x:Static operaEtDies:OurResources.ConcernsNoAppointments}"
					Visibility="{Binding Appointments, Converter={x:Static utility:CommonConverters.IsNullOrEmptyToInverseVisibility}}" />
				<ItemsControl Focusable="False" ItemsSource="{Binding Appointments}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:ConcernsAppointmentViewModel}">
							<Grid Margin="0,2,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" MinWidth="48" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Margin="0,0,8,0"
									FontWeight="SemiBold"
									Text="{Binding Clock}" />
								<TextBlock
									Grid.Column="1"
									Text="{Binding Text}"
									TextWrapping="Wrap" />
								<Button
									Grid.Column="2"
									Margin="4,0,0,0"
									Padding="2"
									VerticalAlignment="Top"
									Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ChooseDestination}"
									Content="{StaticResource DestinationIcon}"
									Focusable="True"
									Style="{StaticResource IconButtonStyle}"
									ToolTip="{x:Static operaEtDies:OurResources.ConcernsAppointmentDestinationToolTip}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</DataTemplate>

	<!--  The frame of a sheet over the center: its title and the button that closes it along the top, over a double rule with
		a lozenge at its center, over the sheet itself. It covers the whole center, between the side columns' double rules.
		The sheet keeps to the center's line length, unless it uses the whole width, such as the map.  -->
	<DataTemplate x:Key="SheetFrameTemplate">
		<Border Background="{DynamicResource SurfaceBrush}">
			<DockPanel Margin="24,12,24,24">
				<DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
					<Button
						VerticalAlignment="Center"
						Command="{Binding DataContext, RelativeSource={RelativeSource AncestorType=layout:SheetHost}, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CloseTopSheet}"
						Content="{StaticResource CloseIcon}"
						DockPanel.Dock="Right"
						Style="{StaticResource IconButtonStyle}"
						ToolTip="{x:Static operaEtDies:OurResources.CloseSheetToolTip}" />
					<TextBlock
						VerticalAlignment="Center"
						Style="{DynamicResource TitleTextStyle}"
						Text="{Binding Title}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
				</DockPanel>
				<layout:DoubleRule
					Margin="0,0,0,12"
					DockPanel.Dock="Top"
					Ornament="{StaticResource LozengeOrnament}"
					OrnamentBrush="{DynamicResource AccentBrush}"
					OrnamentSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=0.75}"
					Stroke="{DynamicResource RuleBrush}" />
				<ContentControl Content="{Binding}" Focusable="False">
					<ContentControl.Style>
						<Style TargetType="ContentControl">
							<Setter Property="MaxWidth" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=53}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsFullWidth}" Value="True">
									<Setter Property="MaxWidth" Value="Infinity" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ContentControl.Style>
				</ContentControl>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  The game being played: the player's character on the left, what they're dealing with in the center, and the state of
		the game (Concerns over the log) on the right.  -->
	<DataTemplate DataType="{x:Type local:GameScreenViewModel}">
		<layout:ColumnLayout>
			<layout:ColumnLayout.LeftContent>
				<ContentControl Content="{Binding CharacterPanel}" Focusable="False" />
			</layout:ColumnLayout.LeftContent>

			<layout:ColumnLayout.RightContent>
				<!--  J moves keyboard focus to the first button in Concerns.  -->
				<layout:SplitColumn
					operaEtDies:FocusRequest.Request="{Binding ConcernsFocusRequest}"
					IsBottomCollapsed="{Binding EventLog.IsCollapsed}"
					TopContent="{Binding Concerns}">
					<ContentControl Content="{Binding EventLog}" Focusable="False" />
				</layout:SplitColumn>
			</layout:ColumnLayout.RightContent>

			<!--  The center, where everything that uses the engine happens, with the sheets drawn over all of it.  -->
			<Grid>
				<!--  The center's text is kept to a comfortable line length, with any extra width as margin. It can't be used while
					a sheet covers it.  -->
				<Grid MaxWidth="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=53}" IsEnabled="{Binding HasSheets, Converter={x:Static utility:CommonConverters.BooleanNot}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  Stopping time while it passes. It's always there, so nothing moves, and only enabled while time passes. When time
						passes at once, there's never anything to stop, so it's hidden, keeping its place. Beside it, what the last save
						or quick load said, until the player does something.  -->
					<DockPanel Grid.Row="0" Margin="24,12,24,0">
						<Button
							Width="120"
							Height="32"
							Command="{Binding TimeRunner, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Stop}"
							Content="{x:Static operaEtDies:OurResources.StopTime}"
							DockPanel.Dock="Right"
							IsEnabled="{Binding TimeRunner.CanBeStopped}"
							ToolTip="{operaEtDies:HotkeyToolTip Escape, Text={x:Static operaEtDies:OurResources.StopTimeToolTip}}"
							ToolTipService.ShowOnDisabled="True"
							Visibility="{Binding TimeRunner.IsInstant, Converter={x:Static utility:CommonConverters.BooleanNotToVisibilityWithHidden}}" />
						<TextBlock
							Margin="0,0,12,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding SaveStatus}"
							TextAlignment="Right"
							TextTrimming="CharacterEllipsis"
							ToolTip="{Binding SaveStatus}" />
					</DockPanel>

					<!--  The current view, with any prompt or conversation on top of it. The current view is only hidden, not removed,
						so it comes back as it was (such as scrolled to the same place) when the view on top closes. Neither can be used
						while time passes.  -->
					<ContentControl
						Grid.Row="1"
						Content="{Binding CurrentView}"
						Focusable="False"
						IsEnabled="{Binding TimeRunner.IsRunning, Converter={x:Static utility:CommonConverters.BooleanNot}}"
						Visibility="{Binding Overlay, Converter={x:Static utility:CommonConverters.IsNotNullToVisibility}}" />
					<ContentControl
						Grid.Row="1"
						Content="{Binding Overlay}"
						Focusable="False"
						IsEnabled="{Binding TimeRunner.IsRunning, Converter={x:Static utility:CommonConverters.BooleanNot}}"
						Visibility="{Binding Overlay, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				</Grid>

				<!--  The sheets, with only the top one showing.  -->
				<layout:SheetHost ItemTemplate="{StaticResource SheetFrameTemplate}" ItemsSource="{Binding Sheets}" />
			</Grid>
		</layout:ColumnLayout>
	</DataTemplate>
</ResourceDictionary>
