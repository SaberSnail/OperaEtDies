<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies.Controls.MainMenu"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  The buttons grow with the text size.  -->
	<Style x:Key="MainMenuButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
		<Setter Property="MinHeight" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=2}" />
		<Setter Property="Margin" Value="0,8,0,0" />
	</Style>

	<!--  The main menu, which takes over the window with no side columns: the title and description, the choices in the
		center (one set before a game and another during one), and any errors loading the data below them.  -->
	<DataTemplate DataType="{x:Type local:MainMenuViewModel}">
		<Grid Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" HorizontalAlignment="Center">
				<TextBlock
					HorizontalAlignment="Center"
					Style="{DynamicResource TitleTextStyle}"
					Text="{Binding Title}" />
				<!--  A double rule with a fleuron under the title.  -->
				<controls:DoubleRule
					Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=14}"
					Margin="0,6,0,0"
					Ornament="{StaticResource FleuronOrnament}"
					OrnamentBrush="{DynamicResource AccentBrush}"
					OrnamentSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.5}"
					Stroke="{DynamicResource RuleBrush}" />
				<TextBlock
					Margin="0,8,0,0"
					HorizontalAlignment="Center"
					FontSize="{DynamicResource LargeFontSize}"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding Description}"
					TextAlignment="Center"
					TextWrapping="Wrap" />
			</StackPanel>

			<!--  Before a game. Going back to the new game being set up is always there, so nothing moves when there is one.  -->
			<StackPanel
				Grid.Row="1"
				Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=15}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Visibility="{Binding IsInGame, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}">
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ContinueNewGame}"
					Content="{x:Static operaEtDies:OurResources.ContinueNewGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewGame}"
					Content="{x:Static operaEtDies:OurResources.StartNewGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=LoadGame}"
					Content="{x:Static operaEtDies:OurResources.LoadGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenSettings}"
					Content="{x:Static operaEtDies:OurResources.Settings}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ManageMods}"
					Content="{x:Static operaEtDies:OurResources.ManageMods}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ExitGame}"
					Content="{x:Static operaEtDies:OurResources.ExitGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
			</StackPanel>

			<!--  During a game. Whether saving worked goes below the choices, so they don't move.  -->
			<StackPanel
				Grid.Row="1"
				Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=15}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Visibility="{Binding IsInGame, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Resume}"
					Content="{x:Static operaEtDies:OurResources.ResumeGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=SaveGame}"
					Content="{x:Static operaEtDies:OurResources.SaveGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=LoadGame}"
					Content="{x:Static operaEtDies:OurResources.LoadGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenSettings}"
					Content="{x:Static operaEtDies:OurResources.Settings}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ManageMods}"
					Content="{x:Static operaEtDies:OurResources.QuitAndManageMods}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=QuitToMainMenu}"
					Content="{x:Static operaEtDies:OurResources.QuitToMainMenu}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ExitGame}"
					Content="{x:Static operaEtDies:OurResources.ExitGame}"
					Style="{StaticResource MainMenuButtonStyle}" />
				<TextBlock
					Margin="0,8,0,0"
					FontSize="{DynamicResource SmallFontSize}"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding SaveStatus}"
					TextAlignment="Center"
					TextWrapping="Wrap"
					Visibility="{Binding SaveStatus, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			</StackPanel>

			<TextBlock
				Grid.Row="2"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{x:Static operaEtDies:OurResources.LoadingGameData}"
				Visibility="{Binding IsLoading, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />

			<StackPanel Grid.Row="2" Visibility="{Binding HasLoadErrors, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<TextBlock Text="{x:Static operaEtDies:OurResources.DataLoadErrorsHeader}" />
				<ItemsControl Margin="12,4,0,0" ItemsSource="{Binding LoadErrors}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding}" TextWrapping="Wrap" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!--  Shows that the game was started with the developer command line option.  -->
			<Border
				Grid.Row="3"
				Margin="0,8,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Style="{DynamicResource DeveloperBorderStyle}"
				Visibility="{Binding IsDeveloper, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<TextBlock
					FontSize="{DynamicResource SmallFontSize}"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{x:Static operaEtDies:OurResources.DeveloperMode}" />
			</Border>

			<!--  The start of the data hash, with the mods hash under it if mods are loaded, and the full hashes in their tool tips.  -->
			<StackPanel
				Grid.Row="3"
				Margin="0,8,0,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				TextElement.FontSize="{DynamicResource SmallFontSize}"
				TextElement.Foreground="{DynamicResource TextMutedBrush}"
				Visibility="{Binding HasHashes, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<TextBlock
					HorizontalAlignment="Right"
					Text="{Binding DataHashText}"
					ToolTip="{Binding DataHash}" />
				<TextBlock
					HorizontalAlignment="Right"
					Text="{Binding ModsHashText}"
					ToolTip="{Binding ModsHash}"
					Visibility="{Binding HasModsHash, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<!--  Asking whether to save the game before leaving it, in the center of the window, with why saving failed under the buttons.  -->
	<DataTemplate DataType="{x:Type local:SavePromptViewModel}">
		<StackPanel
			MaxWidth="480"
			Margin="24"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">
			<TextBlock
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Question}"
				TextWrapping="Wrap" />
			<TextBlock
				Margin="0,8,0,0"
				Text="{Binding Details}"
				TextWrapping="Wrap" />
			<StackPanel
				Margin="0,16,0,0"
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<StackPanel.Resources>
					<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
						<Setter Property="Width" Value="120" />
						<Setter Property="Height" Value="32" />
						<Setter Property="Margin" Value="8,0,0,0" />
					</Style>
				</StackPanel.Resources>
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Save}"
					Content="{x:Static operaEtDies:OurResources.SaveGame}"
					IsDefault="True" />
				<Button Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=DontSave}" Content="{x:Static operaEtDies:OurResources.DontSave}" />
				<Button Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Cancel}" Content="{x:Static operaEtDies:OurResources.Cancel}" />
			</StackPanel>
			<TextBlock
				Margin="0,8,0,0"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding Error}"
				TextWrapping="Wrap"
				Visibility="{Binding Error, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
