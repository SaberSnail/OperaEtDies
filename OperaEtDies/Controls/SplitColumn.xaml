<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  The top part, the ribbon splitter, and the bottom part. The split starts two fifths of the way down. The rows'
		smallest heights are set by the control, in ems. The splitter
		is drawn above the bottom part, so its ribbon can hang down beside the bottom part's heading.  -->
	<Style TargetType="local:SplitColumn">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:SplitColumn">
					<Grid x:Name="PART_Grid">
						<Grid.RowDefinitions>
							<RowDefinition Height="2*" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="3*" />
						</Grid.RowDefinitions>

						<ContentPresenter Grid.Row="0" Content="{TemplateBinding TopContent}" />
						<ContentPresenter Grid.Row="2" />
						<GridSplitter
							Grid.Row="1"
							Panel.ZIndex="1"
							IsEnabled="{Binding IsBottomCollapsed, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static utility:CommonConverters.BooleanNot}}"
							Style="{DynamicResource RibbonSplitterStyle}"
							ToolTip="{x:Static operaEtDies:OurResources.LogSplitterToolTip}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
