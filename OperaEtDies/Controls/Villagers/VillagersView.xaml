<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Villagers"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  The villagers sheet. The people in each family use the person template from the location view.  -->
	<DataTemplate DataType="{x:Type local:VillagersViewModel}">
		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Families}">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type local:VillagerFamilyViewModel}">
						<StackPanel Margin="0,12,0,12">
							<!--  The family's name, with a button that makes their home the player's destination.  -->
							<DockPanel Margin="0,0,0,8">
								<Button
									Margin="12,0,0,0"
									Padding="8,2"
									VerticalAlignment="Center"
									Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=HeadHome}"
									Content="{x:Static operaEtDies:OurResources.VillagerHeadHome}"
									DockPanel.Dock="Right"
									ToolTip="{Binding HeadHomeToolTip}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="{DynamicResource LargeFontSize}"
									FontWeight="Bold"
									Text="{Binding Title}"
									TextWrapping="Wrap" />
							</DockPanel>

							<!--  For developers: the family's wealth level, and a way to go straight to its house.  -->
							<Border
								Margin="0,0,0,8"
								HorizontalAlignment="Left"
								Style="{DynamicResource DeveloperBorderStyle}"
								Visibility="{Binding IsDeveloper, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
								<StackPanel Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center" Text="{Binding Wealth}" />
									<Button
										Margin="12,0,0,0"
										Padding="8,2"
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=VisitHome}"
										Content="{Binding HomeTitle}" />
								</StackPanel>
							</Border>

							<ItemsControl ItemsSource="{Binding People}" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DataTemplate>

</ResourceDictionary>
