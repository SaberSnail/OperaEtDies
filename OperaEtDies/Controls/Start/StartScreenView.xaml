<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Start"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  What the player can start: what they're in the middle of, and each need, with how it's going and a split button
		that starts it (with shorter shifts and having it done for them in its menu), or why it can't be started now. The
		note sits after the button, so it doesn't move it.  -->
	<DataTemplate DataType="{x:Type local:StartScreenViewModel}">
		<Grid Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<DockPanel Grid.Row="0" LastChildFill="True">
				<Button
					Width="120"
					Height="32"
					VerticalAlignment="Center"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Close}"
					Content="{x:Static operaEtDies:OurResources.CloseView}"
					DockPanel.Dock="Right" />
				<TextBlock
					Style="{DynamicResource TitleTextStyle}"
					Text="{Binding Title}"
					TextWrapping="Wrap" />
			</DockPanel>

			<StackPanel Grid.Row="1" Margin="0,12,0,0">
				<TextBlock
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding InProgress}"
					TextWrapping="Wrap"
					Visibility="{Binding InProgress, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			</StackPanel>

			<ScrollViewer
				Grid.Row="2"
				Margin="0,12,0,0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding Choices}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:StartChoiceViewModel}">
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="160" />
									<ColumnDefinition Width="200" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Margin="0,8,0,0"
									VerticalAlignment="Top"
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									Grid.Column="1"
									Margin="12,8,0,0"
									VerticalAlignment="Top"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding Status}"
									TextTrimming="CharacterEllipsis" />
								<WrapPanel Grid.Column="2" Margin="12,0,0,0">
									<controls:SplitButton
										MinWidth="200"
										MinHeight="32"
										Margin="0,0,8,8"
										Action="{Binding Action}"
										Visibility="{Binding Action, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
									<TextBlock
										Margin="0,8,0,0"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Note}"
										TextWrapping="Wrap" />
								</WrapPanel>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</DataTemplate>
</ResourceDictionary>
