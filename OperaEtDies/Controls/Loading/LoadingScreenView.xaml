<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Loading">

	<!--  The loading screen: an otherwise blank window with "Loading…" and the sun and moon going around a circle in the
		center. They wait a moment before fading in, so a quick load doesn't flash them.  -->
	<DataTemplate DataType="{x:Type local:LoadingScreenViewModel}">
		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			controls:Motion.AppearsAfterDelay="True">
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="{DynamicResource LargeFontSize}"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding Text}" />
			<local:LoadingDial
				Width="64"
				Height="64"
				Margin="0,12,0,0"
				MoonBrush="{DynamicResource MoonBrush}"
				Stroke="{DynamicResource RuleBrush}"
				SunBrush="{DynamicResource SunBrush}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
