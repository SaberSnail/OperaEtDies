<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Locations"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A person who can be examined (opening a view focused on them), with what they're doing at the end of the row, so it
		doesn't move the buttons. In the player's location, they can be talked with and followed. Also used by the list of
		villagers, where the player is labeled, and developers can go to where anyone else is.  -->
	<DataTemplate DataType="{x:Type local:LocationPersonViewModel}">
		<Grid Margin="0,0,0,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  A small portrait beside the name, no taller than the buttons.  -->
			<DockPanel Grid.Row="0" Grid.Column="0">
				<Image
					Width="32"
					Height="32"
					Margin="0,0,8,0"
					DockPanel.Dock="Left"
					Source="{Binding Portrait}"
					Stretch="Uniform" />
				<TextBlock
					VerticalAlignment="Center"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
			<WrapPanel
				Grid.Row="0"
				Grid.Column="1"
				Margin="12,0,0,0">
				<Button
					Width="120"
					Height="32"
					Margin="0,0,0,4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
					Content="{x:Static operaEtDies:OurResources.ExamineCharacter}" />
				<Button
					Width="80"
					Height="32"
					Margin="8,0,0,4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Talk}"
					Content="{x:Static operaEtDies:OurResources.TalkToPerson}"
					Visibility="{Binding CanTalk, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<Button
					Width="130"
					Height="32"
					Margin="8,0,0,4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleFollow}"
					Content="{Binding FollowText}"
					Visibility="{Binding CanFollow, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<TextBlock
					Margin="12,0,0,4"
					VerticalAlignment="Center"
					FontWeight="Bold"
					Text="{Binding PlayerLabel}"
					Visibility="{Binding PlayerLabel, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				<Border
					Margin="12,0,0,4"
					Style="{DynamicResource DeveloperBorderStyle}"
					Visibility="{Binding CanGoTo, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<Button
						Padding="8,2"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=GoTo}"
						Content="{x:Static operaEtDies:OurResources.GoToPerson}" />
				</Border>
				<TextBlock
					Margin="12,0,0,4"
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding Activity}"
					TextWrapping="Wrap" />
			</WrapPanel>

			<!--  For developers, where the person is going and why they chose to.  -->
			<Border
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="0,8,0,0"
				Style="{DynamicResource DeveloperBorderStyle}"
				Visibility="{Binding DeveloperGoal, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
				<StackPanel>
					<TextBlock Text="{Binding DeveloperGoal}" TextWrapping="Wrap" />
					<TextBlock
						Foreground="{DynamicResource TextMutedBrush}"
						Text="{Binding DeveloperGoalReason}"
						TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</Grid>
	</DataTemplate>

	<!--  A place the player can go to, as a split button with the number key that goes there. Icons at its left mark the
		player's home, workplace, or next appointment's place, and the way to their destination (in the accent color), with
		what they mean in the button's tooltip. The way to the destination has walking all the way there in its menu. A path
		to another quarter shows which way it goes above the description.  -->
	<DataTemplate x:Key="LocationConnectionTemplate" DataType="{x:Type local:LocationConnectionViewModel}">
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="200" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<controls:SplitButton
				Grid.Column="0"
				MinHeight="32"
				VerticalAlignment="Top"
				HorizontalContentAlignment="Stretch"
				Action="{Binding Action}">
				<controls:SplitButton.Leading>
					<ItemsControl Focusable="False" ItemsSource="{Binding Markers}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:ExitMarker}">
								<Viewbox
									Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1}"
									Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1}"
									Margin="0,0,2,0">
									<Canvas Width="24" Height="24">
										<Path
											x:Name="Icon"
											Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
											StrokeEndLineCap="Round"
											StrokeLineJoin="Round"
											StrokeStartLineCap="Round"
											StrokeThickness="1.8" />
									</Canvas>
								</Viewbox>
								<DataTemplate.Triggers>
									<DataTrigger Binding="{Binding}" Value="{x:Static local:ExitMarker.Home}">
										<Setter TargetName="Icon" Property="Data" Value="{DynamicResource HomeIcon}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding}" Value="{x:Static local:ExitMarker.Work}">
										<Setter TargetName="Icon" Property="Data" Value="{DynamicResource WorkIcon}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding}" Value="{x:Static local:ExitMarker.Appointment}">
										<Setter TargetName="Icon" Property="Data" Value="{DynamicResource AppointmentIcon}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding}" Value="{x:Static local:ExitMarker.TowardDestination}">
										<Setter TargetName="Icon" Property="Data" Value="{DynamicResource ThisWayIcon}" />
										<Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource AccentBrush}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding}" Value="{x:Static local:ExitMarker.Destination}">
										<Setter TargetName="Icon" Property="Data" Value="{DynamicResource DestinationIcon}" />
										<Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource AccentBrush}" />
									</DataTrigger>
								</DataTemplate.Triggers>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</controls:SplitButton.Leading>
			</controls:SplitButton>
			<StackPanel
				Grid.Column="1"
				Margin="12,0,0,0"
				VerticalAlignment="Center">
				<!--  The route, if it's a path, and how long it takes to get there.  -->
				<WrapPanel>
					<TextBlock
						Margin="0,0,8,0"
						Text="{Binding Route}"
						Visibility="{Binding HasRoute, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
					<TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding TravelTimeText}" />
				</WrapPanel>
				<TextBlock
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<DataTemplate DataType="{x:Type local:LocationScreenViewModel}">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="24">
				<TextBlock
					Style="{DynamicResource TitleTextStyle}"
					Text="{Binding Title}"
					TextWrapping="Wrap" />
				<!--  The description opens with a drop cap.  -->
				<controls:DropCapText
					Margin="0,12,0,0"
					CapBrush="{DynamicResource AccentBrush}"
					FontFamily="{DynamicResource NarrativeFontFamily}"
					FontSize="{DynamicResource LargeFontSize}"
					Text="{Binding Description}">
					<!--  Examining the location, shown once, right after the description, until it's been examined.  -->
					<TextBlock
						FontFamily="{DynamicResource InterfaceFontFamily}"
						FontSize="{DynamicResource DefaultFontSize}"
						Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}">
						<Hyperlink
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
							Style="{StaticResource MoreLinkStyle}"
							ToolTip="{x:Static operaEtDies:OurResources.ExamineLocationToolTip}">
							<Run Text="{x:Static operaEtDies:OurResources.ExamineLocationMore}" />
						</Hyperlink>
					</TextBlock>
				</controls:DropCapText>

				<!--  The detailed description, shown once the location has been examined.  -->
				<ItemsControl
					Margin="0,12,0,0"
					FontFamily="{DynamicResource NarrativeFontFamily}"
					ItemsSource="{Binding LongDescription}"
					Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="{DynamicResource LargeFontSize}"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding}"
								TextWrapping="Wrap" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  A tailpiece ending the description.  -->
				<Viewbox
					Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.1}"
					Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.1}"
					Margin="0,4,0,0"
					HorizontalAlignment="Center">
					<Canvas Width="24" Height="24">
						<Path Data="{StaticResource TailpieceOrnament}" Fill="{DynamicResource AccentBrush}" />
					</Canvas>
				</Viewbox>

				<!--  Waiting here (with other times to wait until in its menu), and choosing something to start, such as work or a
					chore. (Walking all the way to the destination is in the menu of the exit that's the way there.) How the last
					wait or action went is on the line below the buttons, which is always there, so a message of a line doesn't
					move anything.  -->
				<WrapPanel Margin="0,12,0,0">
					<controls:SplitButton
						Width="120"
						MinHeight="32"
						Action="{Binding WaitAction}" />
					<Button
						Width="120"
						Height="32"
						Margin="8,0,0,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ChooseStart}"
						Content="{x:Static operaEtDies:OurResources.ViewStart}"
						ToolTip="{operaEtDies:HotkeyToolTip Start, Text={x:Static operaEtDies:OurResources.StartToolTip}}" />
				</WrapPanel>
				<TextBlock
					MinHeight="{Binding Path=FontSize, RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.35}"
					Margin="0,8,0,0"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding WaitResult}"
					TextWrapping="Wrap" />

				<!--  What the player is in the middle of: the step they're on, with icon buttons to show the steps after it (listed
					below the buttons, so the buttons don't move) and to stop, then a split button that presses the step's own
					button, or has the step done for them, with having it or all of it done for them in its menu, and at the end
					of the row, so they don't move the others, the options to choose from. Anything else they're in the middle of
					is listed last, to switch to.  -->
				<StackPanel DataContext="{Binding Steps}" Visibility="{Binding Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{Binding Title}" />
					<TextBlock
						FontWeight="Bold"
						Text="{Binding Next}"
						TextWrapping="Wrap"
						Visibility="{Binding Next, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
					<WrapPanel Margin="0,8,0,0">
						<ToggleButton
							Margin="0,0,0,4"
							VerticalAlignment="Center"
							Content="{StaticResource StepsIcon}"
							IsChecked="{Binding IsExpanded}"
							Style="{StaticResource IconToggleButtonStyle}"
							ToolTip="{Binding ExpandText}" />
						<Button
							Margin="4,0,0,4"
							VerticalAlignment="Center"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Stop}"
							Content="{StaticResource StopIcon}"
							Focusable="True"
							Style="{StaticResource IconButtonStyle}"
							ToolTip="{x:Static operaEtDies:OurResources.PlayerStepsStopToolTip}" />
						<controls:SplitButton
							MinWidth="200"
							MinHeight="32"
							Margin="8,0,0,4"
							Action="{Binding Primary}" />
						<TextBlock
							Margin="12,0,0,4"
							VerticalAlignment="Center"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding Action.Note}" />
						<ItemsControl ItemsSource="{Binding Choices}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:PlayerStepActionViewModel}">
									<Button
										MinWidth="120"
										Height="32"
										Margin="8,0,0,4"
										Padding="8,0"
										operaEtDies:Hotkeys.Badge="{Binding Badge}"
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
										Content="{Binding Text}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</WrapPanel>
					<ItemsControl
						Margin="0,8,0,0"
						ItemsSource="{Binding Steps}"
						Visibility="{Binding IsExpanded, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:PlayerStepItemViewModel}">
								<!--  The step the player is on stands out.  -->
								<TextBlock Margin="0,0,0,4" Text="{Binding Text}" TextWrapping="Wrap">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsNext}" Value="True">
													<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
													<Setter Property="FontWeight" Value="Bold" />
												</DataTrigger>
												<DataTrigger Binding="{Binding IsReached}" Value="True">
													<Setter Property="TextDecorations" Value="Strikethrough" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<StackPanel Visibility="{Binding HasOthers, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock Margin="0,16,0,8" Text="{x:Static operaEtDies:OurResources.PlayerStepsOthersHeader}" />
						<ItemsControl ItemsSource="{Binding Others}">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:PlayerStepActionViewModel}">
									<Button
										MinWidth="160"
										Height="32"
										Margin="0,0,0,4"
										Padding="8,0"
										HorizontalAlignment="Left"
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
										Content="{Binding Text}"
										ToolTip="{x:Static operaEtDies:OurResources.PlayerStepsSwitchToolTip}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<!--  A reminder of bundles kept to finish these steps later, last, so it doesn't move the controls above.  -->
					<TextBlock
						Margin="0,8,0,0"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="{Binding CarryWarning}"
						TextWrapping="Wrap"
						Visibility="{Binding CarryWarning, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				</StackPanel>

				<StackPanel Visibility="{Binding HasPeople, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PeopleHeader}" />
					<ItemsControl ItemsSource="{Binding People}" />
				</StackPanel>

				<!--  Paths to other quarters, in compass order, each with its direction and what it's called.  -->
				<StackPanel Visibility="{Binding HasPaths, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PathsHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Paths}" />
				</StackPanel>

				<!--  The houses and businesses in a quarter, or the quarter a house or business is in.  -->
				<StackPanel Visibility="{Binding HasPlaces, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{Binding PlacesHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Places}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DataTemplate>

	<!--  The player being asked whether to keep going with what they're doing, with buttons to keep going or stop.  -->
	<DataTemplate DataType="{x:Type local:RepeatPromptViewModel}">
		<StackPanel Margin="24">
			<TextBlock
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="1"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Continue}"
					Content="{Binding ContinueText}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Stop}"
					Content="{x:Static operaEtDies:OurResources.RepeatPromptStop}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  The player being asked how to stop steps with something left to take care of: finish up first, keep what they
		carry to finish later, just stop, or keep going.  -->
	<DataTemplate DataType="{x:Type local:StopPromptViewModel}">
		<StackPanel Margin="24">
			<TextBlock
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<WrapPanel Margin="0,12,0,0">
				<Button
					MinWidth="120"
					Height="32"
					Margin="0,0,8,4"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="1"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=FinishUp}"
					Content="{x:Static operaEtDies:OurResources.StopPromptFinishUp}"
					Visibility="{Binding CanFinishUp, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="0,0,8,4"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Keep}"
					Content="{x:Static operaEtDies:OurResources.StopPromptKeep}"
					Visibility="{Binding CanKeep, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="0,0,8,4"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="3"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=JustStop}"
					Content="{x:Static operaEtDies:OurResources.StopPromptJustStop}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="0,0,8,4"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Cancel}"
					Content="{x:Static operaEtDies:OurResources.StopPromptCancel}" />
			</WrapPanel>
		</StackPanel>
	</DataTemplate>

	<!--  Something that happened while time passed, such as a missed appointment, with a button to close it.  -->
	<DataTemplate DataType="{x:Type local:NoticePromptViewModel}">
		<StackPanel Margin="24">
			<TextBlock
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<Button
				MinWidth="120"
				Height="32"
				Margin="0,12,0,0"
				Padding="12,0"
				HorizontalAlignment="Left"
				operaEtDies:Hotkeys.Badge="1"
				Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Dismiss}"
				Content="{x:Static operaEtDies:OurResources.NoticeDismiss}" />
		</StackPanel>
	</DataTemplate>

	<!--  A question someone asked the player as one of their steps, with their portrait, and buttons to answer.  -->
	<DataTemplate DataType="{x:Type local:AskPromptViewModel}">
		<StackPanel Margin="24">
			<Image
				Width="96"
				HorizontalAlignment="Left"
				Source="{Binding Asker.Portrait}"
				Stretch="Uniform"
				Visibility="{Binding Asker.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<TextBlock
				Margin="0,12,0,0"
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<TextBlock
				Margin="0,8,0,0"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding Warning}"
				TextWrapping="Wrap"
				Visibility="{Binding Warning, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="1"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Yes}"
					Content="{x:Static operaEtDies:OurResources.AskRequestYes}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=No}"
					Content="{x:Static operaEtDies:OurResources.AskRequestNo}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  The other of an appointment asking whether to start it, with their portrait and name, and buttons to answer.  -->
	<DataTemplate DataType="{x:Type local:StartPromptViewModel}">
		<StackPanel Margin="24">
			<Image
				Width="96"
				HorizontalAlignment="Left"
				Source="{Binding Asker.Portrait}"
				Stretch="Uniform"
				Visibility="{Binding Asker.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<TextBlock
				Margin="0,12,0,0"
				FontWeight="Bold"
				Text="{Binding Asker.Name}" />
			<TextBlock
				Margin="0,4,0,0"
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="1"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Yes}"
					Content="{x:Static operaEtDies:OurResources.StartRequestYes}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=No}"
					Content="{x:Static operaEtDies:OurResources.StartRequestNo}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  A reminder that it's time to set off for an appointment, with the portrait of the one it's with, and buttons to set off
		or call it off.  -->
	<DataTemplate DataType="{x:Type local:AppointmentPromptViewModel}">
		<StackPanel Margin="24">
			<Image
				Width="96"
				HorizontalAlignment="Left"
				Source="{Binding Client.Portrait}"
				Stretch="Uniform"
				Visibility="{Binding Client.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<TextBlock
				Margin="0,12,0,0"
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="1"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=SetOffNow}"
					Content="{x:Static operaEtDies:OurResources.AppointmentSetOff}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					operaEtDies:Hotkeys.Badge="2"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CallOff}"
					Content="{x:Static operaEtDies:OurResources.AppointmentCallOff}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
