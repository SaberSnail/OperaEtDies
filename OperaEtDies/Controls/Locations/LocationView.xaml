<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Locations"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A person who can be examined. Also used by the list of villagers.  -->
	<DataTemplate DataType="{x:Type local:LocationPersonViewModel}">
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				VerticalAlignment="Center"
				Text="{Binding Name}"
				TextTrimming="CharacterEllipsis" />
			<Button
				Grid.Row="0"
				Grid.Column="1"
				Width="120"
				Height="32"
				Margin="12,0,0,0"
				HorizontalAlignment="Left"
				Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
				Content="{x:Static operaEtDies:OurResources.ExamineCharacter}" />

			<!--  The description, shown once the character has been examined.  -->
			<TextBlock
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="0,8,0,0"
				Foreground="{DynamicResource FontLightBrush}"
				Text="{Binding Description}"
				TextWrapping="Wrap"
				Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
		</Grid>
	</DataTemplate>

	<!--  A place the player can go to. A path to another quarter shows which way it goes above the description.  -->
	<DataTemplate x:Key="LocationConnectionTemplate" DataType="{x:Type local:LocationConnectionViewModel}">
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="0"
				Height="32"
				VerticalAlignment="Top"
				Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Travel}"
				Content="{Binding Title}" />
			<StackPanel
				Grid.Column="1"
				Margin="12,0,0,0"
				VerticalAlignment="Center">
				<TextBlock
					Text="{Binding Route}"
					TextWrapping="Wrap"
					Visibility="{Binding HasRoute, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<TextBlock
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<DataTemplate DataType="{x:Type local:LocationScreenViewModel}">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="24">
				<TextBlock
					FontSize="{DynamicResource TitleFontSize}"
					Text="{Binding Title}"
					TextWrapping="Wrap" />
				<TextBlock
					Margin="0,12,0,0"
					FontSize="{DynamicResource LargeFontSize}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<!--  The detailed description, shown once the location has been examined.  -->
				<ItemsControl
					Margin="0,12,0,0"
					ItemsSource="{Binding LongDescription}"
					Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="{DynamicResource LargeFontSize}"
								Foreground="{DynamicResource FontLightBrush}"
								Text="{Binding}"
								TextWrapping="Wrap" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Button
					Width="120"
					Height="32"
					Margin="0,12,0,0"
					HorizontalAlignment="Left"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
					Content="{x:Static operaEtDies:OurResources.ExamineLocation}" />

				<StackPanel Visibility="{Binding HasPeople, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PeopleHeader}" />
					<ItemsControl ItemsSource="{Binding People}" />
				</StackPanel>

				<!--  Paths to other quarters, in compass order, each with its direction and what it's called.  -->
				<StackPanel Visibility="{Binding HasPaths, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PathsHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Paths}" />
				</StackPanel>

				<!--  The houses and businesses in a quarter, or the quarter a house or business is in.  -->
				<StackPanel Visibility="{Binding HasPlaces, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{Binding PlacesHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Places}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DataTemplate>

</ResourceDictionary>
