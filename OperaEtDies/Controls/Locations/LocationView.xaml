<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Locations"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A person who can be examined (opening a view focused on them), with what they're doing at the end of the row, so it
		doesn't move the buttons. In the player's location, they can be talked with and followed. Also used by the list of
		villagers, where the player is labeled, and developers can go to where anyone else is.  -->
	<DataTemplate DataType="{x:Type local:LocationPersonViewModel}">
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  A small portrait beside the name, no taller than the buttons.  -->
			<DockPanel Grid.Row="0" Grid.Column="0">
				<Image
					Width="32"
					Height="32"
					Margin="0,0,8,0"
					DockPanel.Dock="Left"
					Source="{Binding Portrait}"
					Stretch="Uniform" />
				<TextBlock
					VerticalAlignment="Center"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
			<StackPanel
				Grid.Row="0"
				Grid.Column="1"
				Margin="12,0,0,0"
				Orientation="Horizontal">
				<Button
					Width="120"
					Height="32"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
					Content="{x:Static operaEtDies:OurResources.ExamineCharacter}" />
				<Button
					Width="80"
					Height="32"
					Margin="8,0,0,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Talk}"
					Content="{x:Static operaEtDies:OurResources.TalkToPerson}"
					Visibility="{Binding CanTalk, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<Button
					Width="130"
					Height="32"
					Margin="8,0,0,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleFollow}"
					Content="{Binding FollowText}"
					Visibility="{Binding CanFollow, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<TextBlock
					Margin="12,0,0,0"
					VerticalAlignment="Center"
					FontWeight="Bold"
					Text="{Binding PlayerLabel}"
					Visibility="{Binding PlayerLabel, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				<Border
					Margin="12,0,0,0"
					Style="{DynamicResource DeveloperBorderStyle}"
					Visibility="{Binding CanGoTo, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<Button
						Padding="8,2"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=GoTo}"
						Content="{x:Static operaEtDies:OurResources.GoToPerson}" />
				</Border>
				<TextBlock
					Margin="12,0,0,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding Activity}" />
			</StackPanel>

			<!--  For developers, where the person is going and why they chose to.  -->
			<Border
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="0,8,0,0"
				Style="{DynamicResource DeveloperBorderStyle}"
				Visibility="{Binding DeveloperGoal, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
				<StackPanel>
					<TextBlock Text="{Binding DeveloperGoal}" TextWrapping="Wrap" />
					<TextBlock
						Foreground="{DynamicResource FontLightBrush}"
						Text="{Binding DeveloperGoalReason}"
						TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</Grid>
	</DataTemplate>

	<!--  A place the player can go to, marked if it's the player's home or workplace. A path to another quarter shows which way it goes above the description.  -->
	<DataTemplate x:Key="LocationConnectionTemplate" DataType="{x:Type local:LocationConnectionViewModel}">
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="0"
				Height="32"
				VerticalAlignment="Top"
				Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Travel}">
				<!--  The player's home and workplace are marked, like on the map.  -->
				<DockPanel>
					<Border
						DockPanel.Dock="Left"
						Margin="0,0,6,0"
						Padding="3,0"
						VerticalAlignment="Center"
						Background="{DynamicResource MapCurrentBrush}"
						Visibility="{Binding Marker, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
						<TextBlock
							FontSize="{DynamicResource SmallFontSize}"
							FontWeight="Bold"
							Foreground="{DynamicResource MapVillageBrush}"
							Text="{Binding Marker}" />
					</Border>
					<TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
				</DockPanel>
			</Button>
			<StackPanel
				Grid.Column="1"
				Margin="12,0,0,0"
				VerticalAlignment="Center">
				<!--  The route, if it's a path, and how long it takes to get there.  -->
				<WrapPanel>
					<TextBlock
						Margin="0,0,8,0"
						Text="{Binding Route}"
						Visibility="{Binding HasRoute, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
					<TextBlock Foreground="{DynamicResource FontLightBrush}" Text="{Binding TravelTimeText}" />
				</WrapPanel>
				<TextBlock
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<DataTemplate DataType="{x:Type local:LocationScreenViewModel}">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="24">
				<TextBlock
					FontSize="{DynamicResource TitleFontSize}"
					Text="{Binding Title}"
					TextWrapping="Wrap" />
				<TextBlock
					Margin="0,12,0,0"
					FontSize="{DynamicResource LargeFontSize}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<!--  The detailed description, shown once the location has been examined.  -->
				<ItemsControl
					Margin="0,12,0,0"
					ItemsSource="{Binding LongDescription}"
					Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="{DynamicResource LargeFontSize}"
								Foreground="{DynamicResource FontLightBrush}"
								Text="{Binding}"
								TextWrapping="Wrap" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  Examining the location, and waiting here. How the last wait went is beside the buttons, so it doesn't move anything.  -->
				<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
					<Button
						Width="120"
						Height="32"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
						Content="{x:Static operaEtDies:OurResources.ExamineLocation}" />
					<Button
						Width="120"
						Height="32"
						Margin="8,0,0,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Wait}"
						Content="{x:Static operaEtDies:OurResources.Wait}"
						ToolTip="{x:Static operaEtDies:OurResources.WaitToolTip}" />
					<TextBlock
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource FontLightBrush}"
						Text="{Binding WaitResult}" />
				</StackPanel>

				<!--  What the player can spend time on here, each with its choices of how long, which show how long they take.  -->
				<StackPanel Visibility="{Binding HasActions, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.ActionsHeader}" />
					<ItemsControl ItemsSource="{Binding Actions}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:PlayerActionViewModel}">
								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="160" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										Margin="0,8,0,0"
										VerticalAlignment="Top"
										Text="{Binding Title}"
										TextTrimming="CharacterEllipsis" />
									<!--  While the action is closed, when it's open is shown in place of its options.  -->
									<TextBlock
										Grid.Column="1"
										Margin="12,8,0,8"
										VerticalAlignment="Top"
										Foreground="{DynamicResource FontLightBrush}"
										Text="{Binding OpeningHours}"
										TextWrapping="Wrap"
										Visibility="{Binding OpeningHours, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
									<ItemsControl
										Grid.Column="1"
										Margin="12,0,0,0"
										ItemsSource="{Binding Options}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="{x:Type local:PlayerActionOptionViewModel}">
												<Button
													MinWidth="120"
													Height="32"
													Margin="0,0,8,8"
													Padding="8,0"
													Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
													Content="{Binding Text}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel Visibility="{Binding HasPeople, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PeopleHeader}" />
					<ItemsControl ItemsSource="{Binding People}" />
				</StackPanel>

				<!--  Paths to other quarters, in compass order, each with its direction and what it's called.  -->
				<StackPanel Visibility="{Binding HasPaths, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PathsHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Paths}" />
				</StackPanel>

				<!--  The houses and businesses in a quarter, or the quarter a house or business is in.  -->
				<StackPanel Visibility="{Binding HasPlaces, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{Binding PlacesHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Places}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DataTemplate>

</ResourceDictionary>
