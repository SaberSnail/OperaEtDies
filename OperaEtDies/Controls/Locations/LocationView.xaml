<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Locations"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A person who can be examined (opening a view focused on them), with what they're doing at the end of the row, so it
		doesn't move the buttons. In the player's location, they can be talked with and followed. Also used by the list of
		villagers, where the player is labeled, and developers can go to where anyone else is.  -->
	<DataTemplate DataType="{x:Type local:LocationPersonViewModel}">
		<Grid Margin="0,0,0,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  A small portrait beside the name, no taller than the buttons.  -->
			<DockPanel Grid.Row="0" Grid.Column="0">
				<Image
					Width="32"
					Height="32"
					Margin="0,0,8,0"
					DockPanel.Dock="Left"
					Source="{Binding Portrait}"
					Stretch="Uniform" />
				<TextBlock
					VerticalAlignment="Center"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
			<WrapPanel
				Grid.Row="0"
				Grid.Column="1"
				Margin="12,0,0,0">
				<Button
					Width="120"
					Height="32"
					Margin="0,0,0,4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
					Content="{x:Static operaEtDies:OurResources.ExamineCharacter}" />
				<Button
					Width="80"
					Height="32"
					Margin="8,0,0,4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Talk}"
					Content="{x:Static operaEtDies:OurResources.TalkToPerson}"
					Visibility="{Binding CanTalk, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<Button
					Width="130"
					Height="32"
					Margin="8,0,0,4"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleFollow}"
					Content="{Binding FollowText}"
					Visibility="{Binding CanFollow, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				<TextBlock
					Margin="12,0,0,4"
					VerticalAlignment="Center"
					FontWeight="Bold"
					Text="{Binding PlayerLabel}"
					Visibility="{Binding PlayerLabel, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				<Border
					Margin="12,0,0,4"
					Style="{DynamicResource DeveloperBorderStyle}"
					Visibility="{Binding CanGoTo, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<Button
						Padding="8,2"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=GoTo}"
						Content="{x:Static operaEtDies:OurResources.GoToPerson}" />
				</Border>
				<TextBlock
					Margin="12,0,0,4"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding Activity}"
					TextWrapping="Wrap" />
			</WrapPanel>

			<!--  For developers, where the person is going and why they chose to.  -->
			<Border
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="0,8,0,0"
				Style="{DynamicResource DeveloperBorderStyle}"
				Visibility="{Binding DeveloperGoal, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
				<StackPanel>
					<TextBlock Text="{Binding DeveloperGoal}" TextWrapping="Wrap" />
					<TextBlock
						Foreground="{DynamicResource FontLightBrush}"
						Text="{Binding DeveloperGoalReason}"
						TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</Grid>
	</DataTemplate>

	<!--  A place the player can go to, marked if it's the player's home or workplace. A path to another quarter shows which way it goes above the description.  -->
	<DataTemplate x:Key="LocationConnectionTemplate" DataType="{x:Type local:LocationConnectionViewModel}">
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="0"
				Height="32"
				VerticalAlignment="Top"
				Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Travel}">
				<!--  The player's home and workplace are marked, like on the map.  -->
				<DockPanel>
					<Border
						DockPanel.Dock="Left"
						Margin="0,0,6,0"
						Padding="3,0"
						VerticalAlignment="Center"
						Background="{DynamicResource MapCurrentBrush}"
						Visibility="{Binding Marker, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
						<TextBlock
							FontSize="{DynamicResource SmallFontSize}"
							FontWeight="Bold"
							Foreground="{DynamicResource MapVillageBrush}"
							Text="{Binding Marker}" />
					</Border>
					<TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
				</DockPanel>
			</Button>
			<StackPanel
				Grid.Column="1"
				Margin="12,0,0,0"
				VerticalAlignment="Center">
				<!--  The route, if it's a path, and how long it takes to get there.  -->
				<WrapPanel>
					<TextBlock
						Margin="0,0,8,0"
						Text="{Binding Route}"
						Visibility="{Binding HasRoute, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
					<TextBlock Foreground="{DynamicResource FontLightBrush}" Text="{Binding TravelTimeText}" />
				</WrapPanel>
				<TextBlock
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<DataTemplate DataType="{x:Type local:LocationScreenViewModel}">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="24">
				<TextBlock
					FontSize="{DynamicResource TitleFontSize}"
					Text="{Binding Title}"
					TextWrapping="Wrap" />
				<TextBlock
					Margin="0,12,0,0"
					FontSize="{DynamicResource LargeFontSize}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<!--  The detailed description, shown once the location has been examined.  -->
				<ItemsControl
					Margin="0,12,0,0"
					ItemsSource="{Binding LongDescription}"
					Visibility="{Binding IsExamined, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="{DynamicResource LargeFontSize}"
								Foreground="{DynamicResource FontLightBrush}"
								Text="{Binding}"
								TextWrapping="Wrap" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  Examining the location, and waiting here. How the last wait went is beside the buttons, wrapping in the space left, so it doesn't move anything.  -->
				<DockPanel Margin="0,12,0,0">
					<Button
						DockPanel.Dock="Left"
						Width="120"
						Height="32"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Examine}"
						Content="{x:Static operaEtDies:OurResources.ExamineLocation}" />
					<Button
						DockPanel.Dock="Left"
						Width="120"
						Height="32"
						Margin="8,0,0,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Wait}"
						Content="{x:Static operaEtDies:OurResources.Wait}"
						ToolTip="{x:Static operaEtDies:OurResources.WaitToolTip}" />
					<TextBlock
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource FontLightBrush}"
						Text="{Binding WaitResult}"
						TextWrapping="Wrap" />
				</DockPanel>

				<!--  What the player is in the middle of: the step they're on, and buttons to have it or all of it done for them,
					to stop, to show the steps after it (listed below the buttons, so the buttons don't move), and at the end of
					the row, so they don't move the others, the step's own button or the options to choose from. Anything else
					they're in the middle of is listed last, to switch to.  -->
				<StackPanel DataContext="{Binding Steps}" Visibility="{Binding Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{Binding Title}" />
					<TextBlock
						FontWeight="Bold"
						Text="{Binding Next}"
						TextWrapping="Wrap"
						Visibility="{Binding Next, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
					<WrapPanel Margin="0,8,0,0">
						<Button
							Width="160"
							Height="32"
							Margin="0,0,0,4"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=DoStep}"
							Content="{x:Static operaEtDies:OurResources.PlayerStepsAutomatic}"
							ToolTip="{x:Static operaEtDies:OurResources.PlayerStepsAutomaticToolTip}" />
						<Button
							Width="160"
							Height="32"
							Margin="8,0,0,4"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=DoAll}"
							Content="{x:Static operaEtDies:OurResources.PlayerStepsDoAll}"
							ToolTip="{x:Static operaEtDies:OurResources.PlayerStepsDoAllToolTip}" />
						<Button
							Width="120"
							Height="32"
							Margin="8,0,0,4"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Stop}"
							Content="{x:Static operaEtDies:OurResources.PlayerStepsStop}"
							ToolTip="{x:Static operaEtDies:OurResources.PlayerStepsStopToolTip}" />
						<Button
							Width="160"
							Height="32"
							Margin="8,0,0,4"
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleExpanded}"
							Content="{Binding ExpandText}" />
						<Button
							MinWidth="160"
							Height="32"
							Margin="8,0,0,4"
							Padding="8,0"
							Command="{Binding Action, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
							Content="{Binding Action.Text}"
							Visibility="{Binding Action, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
						<TextBlock
							Margin="12,0,0,4"
							VerticalAlignment="Center"
							Foreground="{DynamicResource FontLightBrush}"
							Text="{Binding Action.Note}" />
						<ItemsControl ItemsSource="{Binding Choices}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:PlayerStepActionViewModel}">
									<Button
										MinWidth="120"
										Height="32"
										Margin="8,0,0,4"
										Padding="8,0"
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
										Content="{Binding Text}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</WrapPanel>
					<ItemsControl
						Margin="0,8,0,0"
						ItemsSource="{Binding Steps}"
						Visibility="{Binding IsExpanded, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:PlayerStepItemViewModel}">
								<!--  The step the player is on stands out.  -->
								<TextBlock Margin="0,0,0,4" Text="{Binding Text}" TextWrapping="Wrap">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Foreground" Value="{DynamicResource FontLightBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsNext}" Value="True">
													<Setter Property="Foreground" Value="{DynamicResource FontBrush}" />
													<Setter Property="FontWeight" Value="Bold" />
												</DataTrigger>
												<DataTrigger Binding="{Binding IsReached}" Value="True">
													<Setter Property="TextDecorations" Value="Strikethrough" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<StackPanel Visibility="{Binding HasOthers, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
						<TextBlock Margin="0,16,0,8" Text="{x:Static operaEtDies:OurResources.PlayerStepsOthersHeader}" />
						<ItemsControl ItemsSource="{Binding Others}">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:PlayerStepActionViewModel}">
									<Button
										MinWidth="160"
										Height="32"
										Margin="0,0,0,4"
										Padding="8,0"
										HorizontalAlignment="Left"
										Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
										Content="{Binding Text}"
										ToolTip="{x:Static operaEtDies:OurResources.PlayerStepsSwitchToolTip}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</StackPanel>

				<StackPanel Visibility="{Binding HasPeople, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PeopleHeader}" />
					<ItemsControl ItemsSource="{Binding People}" />
				</StackPanel>

				<!--  Paths to other quarters, in compass order, each with its direction and what it's called.  -->
				<StackPanel Visibility="{Binding HasPaths, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{x:Static operaEtDies:OurResources.PathsHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Paths}" />
				</StackPanel>

				<!--  The houses and businesses in a quarter, or the quarter a house or business is in.  -->
				<StackPanel Visibility="{Binding HasPlaces, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<TextBlock Margin="0,24,0,8" Text="{Binding PlacesHeader}" />
					<ItemsControl ItemTemplate="{StaticResource LocationConnectionTemplate}" ItemsSource="{Binding Places}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DataTemplate>

	<!--  The player being asked whether to keep going with what they're doing, with buttons to keep going or stop.  -->
	<DataTemplate DataType="{x:Type local:RepeatPromptViewModel}">
		<StackPanel Margin="24">
			<TextBlock
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Continue}"
					Content="{Binding ContinueText}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Stop}"
					Content="{x:Static operaEtDies:OurResources.RepeatPromptStop}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  Something that happened while time passed, such as a missed appointment, with a button to close it.  -->
	<DataTemplate DataType="{x:Type local:NoticePromptViewModel}">
		<StackPanel Margin="24">
			<TextBlock
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<Button
				MinWidth="120"
				Height="32"
				Margin="0,12,0,0"
				Padding="12,0"
				HorizontalAlignment="Left"
				Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Dismiss}"
				Content="{x:Static operaEtDies:OurResources.NoticeDismiss}" />
		</StackPanel>
	</DataTemplate>

	<!--  A question someone asked the player as one of their steps, with their portrait, and buttons to answer.  -->
	<DataTemplate DataType="{x:Type local:AskPromptViewModel}">
		<StackPanel Margin="24">
			<Image
				Width="96"
				HorizontalAlignment="Left"
				Source="{Binding Asker.Portrait}"
				Stretch="Uniform"
				Visibility="{Binding Asker.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<TextBlock
				Margin="0,12,0,0"
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<TextBlock
				Margin="0,8,0,0"
				Foreground="{DynamicResource FontLightBrush}"
				Text="{Binding Warning}"
				TextWrapping="Wrap"
				Visibility="{Binding Warning, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Yes}"
					Content="{x:Static operaEtDies:OurResources.AskRequestYes}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=No}"
					Content="{x:Static operaEtDies:OurResources.AskRequestNo}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  A reminder that it's time to set off for an appointment, with the portrait of the one it's with, and buttons to set off
		or call it off.  -->
	<DataTemplate DataType="{x:Type local:AppointmentPromptViewModel}">
		<StackPanel Margin="24">
			<Image
				Width="96"
				HorizontalAlignment="Left"
				Source="{Binding Client.Portrait}"
				Stretch="Uniform"
				Visibility="{Binding Client.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<TextBlock
				Margin="0,12,0,0"
				FontSize="{DynamicResource LargeFontSize}"
				Text="{Binding Text}"
				TextWrapping="Wrap" />
			<StackPanel Margin="0,12,0,0" Orientation="Horizontal">
				<Button
					MinWidth="120"
					Height="32"
					Padding="12,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=SetOffNow}"
					Content="{x:Static operaEtDies:OurResources.AppointmentSetOff}" />
				<Button
					MinWidth="120"
					Height="32"
					Margin="8,0,0,0"
					Padding="12,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CallOff}"
					Content="{x:Static operaEtDies:OurResources.AppointmentCallOff}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
