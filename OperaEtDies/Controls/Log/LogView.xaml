<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls.Log"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  One entry in the log, with the date above it when the day changes (under a light rule separating it from the day
		before), and the time beside it when the time changes.  -->
	<DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type local:LogEntryViewModel}">
		<StackPanel>
			<Border
				Height="1"
				Margin="0,8,0,0"
				Background="{DynamicResource RuleBrush}"
				Visibility="{Binding StartsNewDay, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
			<TextBlock
				Margin="0,8,0,4"
				FontWeight="Bold"
				Text="{Binding Day}"
				TextWrapping="Wrap"
				Visibility="{Binding Day, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
			<Grid Margin="0,0,0,4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Column="0"
					MinWidth="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=3}"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding Clock}" />
				<TextBlock
					Grid.Column="1"
					local:LogViewBehaviors.Parts="{Binding Parts}"
					TextWrapping="Wrap" />
			</Grid>
		</StackPanel>
	</DataTemplate>

	<!--  The event log, oldest first, staying scrolled to the newest entry unless the player scrolled back. Right under the
		splitter above it are buttons that open the log in a sheet and collapse it, left of the splitter's ribbon. While it's
		collapsed, a "Log" label beside them says what they open.  -->
	<DataTemplate DataType="{x:Type local:EventLogViewModel}">
		<DockPanel>
			<DockPanel Margin="12,0,48,4" DockPanel.Dock="Top">
				<Button
					Padding="2"
					VerticalAlignment="Center"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleCollapsed}"
					DockPanel.Dock="Right"
					ToolTip="{Binding CollapseToolTip}">
					<Button.Style>
						<Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
							<Setter Property="Content" Value="{StaticResource ChevronDownIcon}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsCollapsed}" Value="True">
									<Setter Property="Content" Value="{StaticResource ChevronUpIcon}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Button
					Padding="2"
					VerticalAlignment="Center"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenSheet}"
					Content="{StaticResource ExpandIcon}"
					DockPanel.Dock="Right"
					Style="{StaticResource IconButtonStyle}"
					ToolTip="{x:Static operaEtDies:OurResources.LogOpenSheetToolTip}" />
				<TextBlock
					Margin="0"
					VerticalAlignment="Center"
					Style="{DynamicResource CaptionTextStyle}"
					Text="{x:Static operaEtDies:OurResources.LogCollapsedHeader}"
					Visibility="{Binding IsCollapsed, Converter={x:Static utility:CommonConverters.BooleanToVisibilityWithHidden}}" />
			</DockPanel>
			<ScrollViewer
				Visibility="{Binding IsCollapsed, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}"
				local:LogViewBehaviors.IsScrolledToEnd="True"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<ItemsControl
					Margin="12,0,12,12"
					FontFamily="{DynamicResource NarrativeFontFamily}"
					ItemTemplate="{StaticResource LogEntryTemplate}"
					ItemsSource="{Binding Entries}" />
			</ScrollViewer>
		</DockPanel>
	</DataTemplate>

	<!--  The log sheet: the same entries as the log in the right column, at a larger size.  -->
	<DataTemplate DataType="{x:Type local:LogSheetViewModel}">
		<ScrollViewer
			local:LogViewBehaviors.IsScrolledToEnd="True"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<ItemsControl
				FontFamily="{DynamicResource NarrativeFontFamily}"
				FontSize="{DynamicResource LargeFontSize}"
				ItemTemplate="{StaticResource LogEntryTemplate}"
				ItemsSource="{Binding Log.Entries}" />
		</ScrollViewer>
	</DataTemplate>

</ResourceDictionary>
