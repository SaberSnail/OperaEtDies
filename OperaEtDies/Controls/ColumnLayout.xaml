<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies.Controls"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  The side columns have widths in ems, so they scale with the text size, and the center gets the room left between
		them. Each side column is divided from the center by a double rule. When the center would be too narrow, the left column
		switches to its narrower compact width, then the right one (see ColumnLayout), and what's in each column sees it
		through ColumnLayout.IsCompact.  -->
	<Style TargetType="local:ColumnLayout">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:ColumnLayout">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Border
							x:Name="LeftColumn"
							Grid.Column="0"
							Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter={x:Static local:ColumnLayout.LeftEms}}"
							local:ColumnLayout.IsCompact="{Binding IsLeftCompact, RelativeSource={RelativeSource TemplatedParent}}"
							Background="{DynamicResource PanelBrush}"
							Visibility="{TemplateBinding LeftContent, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
							<DockPanel>
								<local:DoubleRule
									DockPanel.Dock="Right"
									Orientation="Vertical"
									Stroke="{DynamicResource RuleBrush}" />
								<ContentPresenter Content="{TemplateBinding LeftContent}" />
							</DockPanel>
						</Border>

						<ContentPresenter Grid.Column="1" />

						<Border
							x:Name="RightColumn"
							Grid.Column="2"
							Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter={x:Static local:ColumnLayout.RightEms}}"
							local:ColumnLayout.IsCompact="{Binding IsRightCompact, RelativeSource={RelativeSource TemplatedParent}}"
							Background="{DynamicResource PanelBrush}"
							Visibility="{TemplateBinding RightContent, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
							<DockPanel>
								<local:DoubleRule
									DockPanel.Dock="Left"
									Orientation="Vertical"
									Stroke="{DynamicResource RuleBrush}" />
								<ContentPresenter Content="{TemplateBinding RightContent}" />
							</DockPanel>
						</Border>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsLeftCompact" Value="True">
							<Setter TargetName="LeftColumn" Property="Width" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter={x:Static local:ColumnLayout.LeftCompactEms}}" />
						</Trigger>
						<Trigger Property="IsRightCompact" Value="True">
							<Setter TargetName="RightColumn" Property="Width" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter={x:Static local:ColumnLayout.RightCompactEms}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
