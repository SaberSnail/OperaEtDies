<Window
	x:Class="OperaEtDies.Windows.Main.MainWindowView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:OperaEtDies.Windows.Main"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows"
	Title="{Binding Title}"
	Icon="{Binding Icon, Source={x:Static operaEtDies:AppModel.Instance}}"
	Width="960"
	Height="600"
	d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
	Background="{DynamicResource WindowBackgroundBrush}"
	DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  The sidebar, with the player's character, buttons that open other views in place of the player's location, and the mini-map.  -->
		<Border
			Grid.Column="0"
			Background="{DynamicResource ContentBackgroundBrush}"
			BorderBrush="{DynamicResource ControlBorderBaseBrush}"
			BorderThickness="0,0,1,0">
			<StackPanel Margin="12">
				<!--  The player's portrait and name, as wide as the mini-map.  -->
				<Image
					Width="204"
					Source="{Binding Player.Portrait}"
					Stretch="Uniform"
					Visibility="{Binding Player.Portrait, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				<TextBlock
					Width="204"
					Margin="0,8,0,0"
					Text="{Binding Player.Name}"
					TextAlignment="Center"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding Player.Name}" />

				<!--  The date, any festival or other special day, and the time of day.  -->
				<TextBlock
					Width="204"
					Margin="0,16,0,0"
					Text="{Binding Date}"
					TextAlignment="Center"
					TextWrapping="Wrap" />
				<TextBlock
					Width="204"
					Margin="0,2,0,0"
					FontWeight="Bold"
					Text="{Binding SpecialDay}"
					TextAlignment="Center"
					TextWrapping="Wrap"
					Visibility="{Binding SpecialDay, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
				<TextBlock
					Width="204"
					Margin="0,2,0,24"
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding TimeOfDay}"
					TextAlignment="Center" />

				<Button
					Width="120"
					Height="32"
					HorizontalAlignment="Left"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowVillagers}"
					Content="{x:Static operaEtDies:OurResources.ViewVillagers}" />
				<Button
					Width="120"
					Height="32"
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowMap}"
					Content="{x:Static operaEtDies:OurResources.ViewMap}" />
				<Button
					Width="120"
					Height="32"
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=SaveGame}"
					Content="{x:Static operaEtDies:OurResources.SaveGame}" />
				<TextBlock
					Width="204"
					Margin="0,4,0,0"
					FontSize="{DynamicResource SmallFontSize}"
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding SaveStatus}"
					TextWrapping="Wrap"
					Visibility="{Binding SaveStatus, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />

				<!--  The player's quarter and the quarters its paths lead to.  -->
				<TextBlock
					Margin="0,24,0,8"
					Foreground="{DynamicResource FontLightBrush}"
					Text="{x:Static operaEtDies:OurResources.MiniMapHeader}" />
				<Border
					Width="204"
					Height="204"
					BorderBrush="{DynamicResource ControlBorderBaseBrush}"
					BorderThickness="1">
					<ContentControl
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Content="{Binding MiniMap}"
						ContentTemplate="{DynamicResource TownMapCanvasTemplate}"
						Focusable="False" />
				</Border>
			</StackPanel>
		</Border>

		<ContentControl
			Grid.Column="1"
			Content="{Binding CurrentView}"
			Focusable="False" />
	</Grid>

</Window>
