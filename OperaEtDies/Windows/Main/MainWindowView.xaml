<Window
	x:Class="OperaEtDies.Windows.Main.MainWindowView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies.Windows.Main"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:operaEtDies="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows"
	Title="{Binding Title}"
	Width="1280"
	Height="760"
	d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
	Background="{DynamicResource SurfaceBrush}"
	DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}"
	Icon="{Binding Icon, Source={x:Static operaEtDies:AppModel.Instance}}"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

	<!--  The title bar is drawn by the window (see TitleBar below). The chrome keeps the system's dragging, resizing, snapping,
		and system menu. The caption height follows the title bar's height (see the code-behind).  -->
	<WindowChrome.WindowChrome>
		<WindowChrome
			x:Name="Chrome"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</WindowChrome.WindowChrome>

	<!--  The hotkeys (see Hotkeys) are handled by the code-behind and the view model.  -->

	<!--  A thin border around the window, which is dropped while it's maximized, when the window is also kept inside the
		screen (see the code-behind).  -->
	<Border
		x:Name="WindowFrame"
		BorderBrush="{DynamicResource RuleStrongBrush}"
		BorderThickness="1">
		<DockPanel>
			<!--  The title bar: the game's icon and name, the toolbar during play, the main menu button, and the window buttons. In
				full screen, the icon, the name, and the minimize and maximize buttons are hidden, and a button for leaving full
				screen takes their place beside the close button.  -->
			<Border
				x:Name="TitleBar"
				MinHeight="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=2.25}"
				Background="{DynamicResource ChromeBrush}"
				DockPanel.Dock="Top">
				<DockPanel>
					<!--  A double rule along its bottom, under everything else in it.  -->
					<controls:DoubleRule DockPanel.Dock="Bottom" Stroke="{DynamicResource RuleStrongBrush}" />
					<Image
						Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static operaEtDies:EmConverter.Instance}, ConverterParameter=1.1}"
						Margin="12,0,8,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Left"
						Source="{Binding Icon, Source={x:Static operaEtDies:AppModel.Instance}}"
						Visibility="{Binding Settings.IsFullScreen, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}" />
					<TextBlock
						Margin="0,0,20,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Left"
						Text="{Binding Title}"
						Visibility="{Binding Settings.IsFullScreen, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}" />

					<!--  The window buttons.  -->
					<Button
						Click="OnCloseClick"
						Content="{StaticResource CloseIcon}"
						DockPanel.Dock="Right"
						Style="{StaticResource CloseCaptionButtonStyle}"
						ToolTip="{x:Static operaEtDies:OurResources.CloseWindow}" />
					<Button
						Click="OnLeaveFullScreenClick"
						Content="{StaticResource LeaveFullScreenIcon}"
						DockPanel.Dock="Right"
						Style="{StaticResource CaptionButtonStyle}"
						ToolTip="{operaEtDies:HotkeyToolTip FullScreen, Text={x:Static operaEtDies:OurResources.LeaveFullScreen}}"
						Visibility="{Binding Settings.IsFullScreen, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
					<Button
						Click="OnMaximizeClick"
						DockPanel.Dock="Right"
						Visibility="{Binding Settings.IsFullScreen, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}">
						<Button.Style>
							<Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="Button">
								<Setter Property="Content" Value="{StaticResource MaximizeIcon}" />
								<Setter Property="ToolTip" Value="{x:Static operaEtDies:OurResources.MaximizeWindow}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
										<Setter Property="Content" Value="{StaticResource RestoreIcon}" />
										<Setter Property="ToolTip" Value="{x:Static operaEtDies:OurResources.RestoreWindow}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
					<Button
						Click="OnMinimizeClick"
						Content="{StaticResource MinimizeIcon}"
						DockPanel.Dock="Right"
						Style="{StaticResource CaptionButtonStyle}"
						ToolTip="{x:Static operaEtDies:OurResources.MinimizeWindow}"
						Visibility="{Binding Settings.IsFullScreen, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}" />

					<!--  During play, the main menu button, apart from the window buttons, and the toolbar's buttons. Character,
						villagers, map, and status open sheets over the center, and the buttons of open sheets look pressed. The
						wardrobe and the inventory open in the center. The last button closes every sheet. Using them while time passes
						stops time first.  -->
					<Button
						Margin="0,0,24,0"
						VerticalAlignment="Center"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowMainMenu}"
						Content="{StaticResource MenuIcon}"
						DockPanel.Dock="Right"
						Style="{StaticResource ToolbarButtonStyle}"
						ToolTip="{operaEtDies:HotkeyToolTip Escape, Text={x:Static operaEtDies:OurResources.MainMenuToolTip}}"
						Visibility="{Binding IsPlaying, Converter={x:Static utility:CommonConverters.BooleanToVisibilityWithHidden}}" />
					<StackPanel
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Visibility="{Binding IsPlaying, Converter={x:Static utility:CommonConverters.BooleanToVisibilityWithHidden}}">
						<Button
							operaEtDies:TemplateHelper.IsActive="{Binding Game.IsPlayerCharacterOpen, FallbackValue=False}"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=TogglePlayerCharacter}"
							Content="{StaticResource CharacterIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{operaEtDies:HotkeyToolTip Character, Text={x:Static operaEtDies:OurResources.ViewCharacter}}" />
						<Button
							operaEtDies:TemplateHelper.IsActive="{Binding Game.IsVillagersOpen, FallbackValue=False}"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleVillagers}"
							Content="{StaticResource VillagersIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{operaEtDies:HotkeyToolTip Villagers, Text={x:Static operaEtDies:OurResources.ViewVillagers}}" />
						<Button
							operaEtDies:TemplateHelper.IsActive="{Binding Game.IsMapOpen, FallbackValue=False}"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleMap}"
							Content="{StaticResource MapIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{operaEtDies:HotkeyToolTip Map, Text={x:Static operaEtDies:OurResources.ViewMap}}" />
						<!--  The wardrobe is only open at home.  -->
						<Button
							operaEtDies:TemplateHelper.IsActive="{Binding Game.IsWardrobeOpen, FallbackValue=False}"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleWardrobe}"
							Content="{StaticResource WardrobeIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{operaEtDies:HotkeyToolTip Wardrobe, Text={x:Static operaEtDies:OurResources.WardrobeAtHomeToolTip}}" />
						<Button
							operaEtDies:TemplateHelper.IsActive="{Binding Game.IsInventoryOpen, FallbackValue=False}"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleInventory}"
							Content="{StaticResource InventoryIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{operaEtDies:HotkeyToolTip Inventory, Text={x:Static operaEtDies:OurResources.ViewInventory}}" />
						<Button
							operaEtDies:TemplateHelper.IsActive="{Binding Game.IsStatusOpen, FallbackValue=False}"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ToggleStatus}"
							Content="{StaticResource StatusIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{operaEtDies:HotkeyToolTip Status, Text={x:Static operaEtDies:OurResources.ViewStatus}}" />
						<Button
							Margin="12,0,2,0"
							Command="{Binding Game, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CloseSheets}"
							Content="{StaticResource ReturnToGameIcon}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="{x:Static operaEtDies:OurResources.CloseSheetsToolTip}" />
					</StackPanel>
				</DockPanel>
			</Border>

			<Grid>
				<!--  The game being played, if there is one. It's only hidden, not removed, while a screen is over it, so it comes
					back exactly as it was.  -->
				<ContentControl
					Content="{Binding Game}"
					Focusable="False"
					Visibility="{Binding Screen, Converter={x:Static utility:CommonConverters.IsNotNullToVisibility}}" />

				<!--  The screen taking over the window: the main menu, or a screen opened from it.  -->
				<ContentControl
					Content="{Binding Screen}"
					Focusable="False"
					Visibility="{Binding Screen, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />

				<!--  Asking whether to save before leaving the game, over everything else.  -->
				<ContentControl
					Background="{DynamicResource SurfaceBrush}"
					Content="{Binding SavePrompt}"
					Focusable="False"
					Visibility="{Binding SavePrompt, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
					<ContentControl.Template>
						<ControlTemplate TargetType="ContentControl">
							<Border Background="{TemplateBinding Background}">
								<ContentPresenter />
							</Border>
						</ControlTemplate>
					</ContentControl.Template>
				</ContentControl>
			</Grid>
		</DockPanel>
	</Border>

</Window>
