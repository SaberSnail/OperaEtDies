<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GoldenAnvil.Utility\GoldenAnvil.Utility.Windows\GoldenAnvil.Utility.Windows.csproj" />
    <ProjectReference Include="..\..\..\GoldenAnvil.Utility\GoldenAnvil.Utility\GoldenAnvil.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OperaEtDies.Test" />
    <InternalsVisibleTo Include="PortraitEditor" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="OurResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>OurResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="OurResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>OurResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Copy the Sub Corona data files (JSON, images, etc.) into a Data folder next to the executable. -->
  <PropertyGroup>
    <SubCoronaDataDirectory>$(MSBuildThisFileDirectory)..\..\SubCorona\Data\</SubCoronaDataDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SubCoronaDataDirectory)**\*" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
