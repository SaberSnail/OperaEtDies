<Application
	x:Class="OperaEtDies.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OperaEtDies"
	ShutdownMode="OnExplicitShutdown">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/GoldenAnvil.Utility.Windows;component/Themes/Generic.xaml" />
				<ResourceDictionary Source="Themes/Default/Default.xaml" />
				<ResourceDictionary Source="Themes/Shared/Shared.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
