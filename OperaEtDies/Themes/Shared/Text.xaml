<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:markupExtensions="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<markupExtensions:FontSize x:Key="SmallFontSize" Size="10" />
	<markupExtensions:FontSize x:Key="DefaultFontSize" Size="12" />
	<markupExtensions:FontSize x:Key="LargeFontSize" Size="14" />
	<markupExtensions:FontSize x:Key="TitleFontSize" Size="28" />

	<!--  A person or place named in the event log, which can be clicked. It reads as part of the text, and is underlined on hover.  -->
	<Style x:Key="LogLinkStyle" TargetType="Hyperlink">
		<Setter Property="Foreground" Value="{DynamicResource FontBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="TextDecorations" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="TextDecorations" Value="Underline" />
			</Trigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>