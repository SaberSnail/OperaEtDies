<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  The part of a slider's track before the thumb, filled with ink like a meter. Clicking it moves the thumb back.  -->
	<Style x:Key="SliderFillButtonStyle" TargetType="{x:Type RepeatButton}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="Focusable" Value="false" />
		<Setter Property="IsTabStop" Value="false" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<!--  A transparent border around the fill, so the whole height of the slider can be clicked.  -->
					<Border Background="Transparent">
						<Border
							x:Name="Fill"
							Height="4"
							VerticalAlignment="Center"
							Background="{DynamicResource MeterBrush}"
							CornerRadius="2" />
					</Border>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="Vertical">
							<Setter TargetName="Fill" Property="Height" Value="NaN" />
							<Setter TargetName="Fill" Property="Width" Value="4" />
							<Setter TargetName="Fill" Property="VerticalAlignment" Value="Stretch" />
							<Setter TargetName="Fill" Property="HorizontalAlignment" Value="Center" />
						</DataTrigger>
						<Trigger Property="IsEnabled" Value="false">
							<Setter TargetName="Fill" Property="Background" Value="{DynamicResource TextDisabledBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  The part of a slider's track after the thumb, which shows the track behind it. Clicking it moves the thumb on.  -->
	<Style x:Key="SliderEmptyButtonStyle" TargetType="{x:Type RepeatButton}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="Focusable" Value="false" />
		<Setter Property="IsTabStop" Value="false" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  A slider's thumb: a round knob drawn like a control, with the accent around it on hover and while it's dragged.  -->
	<Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="Focusable" Value="false" />
		<Setter Property="IsTabStop" Value="false" />
		<Setter Property="Width" Value="14" />
		<Setter Property="Height" Value="14" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Thumb}">
					<Ellipse
						x:Name="Knob"
						Fill="{DynamicResource ControlBrush}"
						Stroke="{DynamicResource RuleStrongBrush}"
						StrokeThickness="1" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="true">
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ControlHoverBrush}" />
							<Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource AccentBrush}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="true">
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ControlPressedBrush}" />
							<Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource AccentBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="false">
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ControlDisabledBrush}" />
							<Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  A slider: a thin track, filled with ink up to a round thumb, like the meters. It draws no tick marks.  -->
	<Style TargetType="{x:Type Slider}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="SnapsToDevicePixels" Value="true" />
		<Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisualStyle}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Slider}">
					<Grid MinHeight="18" Background="Transparent">
						<Border
							x:Name="TrackBackground"
							Height="4"
							VerticalAlignment="Center"
							Background="{DynamicResource TrackBrush}"
							CornerRadius="2" />
						<Track x:Name="PART_Track">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonStyle}" />
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Style="{StaticResource SliderThumbStyle}" />
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButtonStyle}" />
							</Track.IncreaseRepeatButton>
						</Track>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="false">
							<Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="Orientation" Value="Vertical">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Slider}">
							<Grid MinWidth="18" Background="Transparent">
								<Border
									x:Name="TrackBackground"
									Width="4"
									HorizontalAlignment="Center"
									Background="{DynamicResource TrackBrush}"
									CornerRadius="2" />
								<Track x:Name="PART_Track">
									<Track.DecreaseRepeatButton>
										<RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonStyle}" />
									</Track.DecreaseRepeatButton>
									<Track.Thumb>
										<Thumb Style="{StaticResource SliderThumbStyle}" />
									</Track.Thumb>
									<Track.IncreaseRepeatButton>
										<RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButtonStyle}" />
									</Track.IncreaseRepeatButton>
								</Track>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsEnabled" Value="false">
									<Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>
