<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies"
	xmlns:system="clr-namespace:System;assembly=mscorlib">

	<system:Double x:Key="SplitterWidth">4.0</system:Double>

	<Style TargetType="{x:Type GridSplitter}">
		<Setter Property="Background" Value="{DynamicResource RuleBrush}" />
		<Setter Property="Width" Value="{DynamicResource SplitterWidth}" />
	</Style>

	<!--  A horizontal splitter drawn as a double rule with a ribbon bookmark hanging from its right end, such as between
		Concerns and the log. The heading of the part below sits right under it, so they read as one piece. On hover, the
		rules turn the accent color, the band is highlighted, and the ribbon brightens. It shows only the rules while it's
		disabled.  -->
	<Style x:Key="RibbonSplitterStyle" TargetType="{x:Type GridSplitter}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="Width" Value="NaN" />
		<Setter Property="Height" Value="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=0.75}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="ResizeDirection" Value="Rows" />
		<Setter Property="ResizeBehavior" Value="PreviousAndNext" />
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type GridSplitter}">
					<Grid>
						<Border x:Name="Band" Background="{TemplateBinding Background}" />
						<controls:DoubleRule
							x:Name="Rules"
							Margin="12,0"
							VerticalAlignment="Center"
							Stroke="{DynamicResource RuleBrush}" />
						<!--  In a canvas, so it can hang below the band without being clipped.  -->
						<Canvas
							Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=0.9}"
							Margin="0,0,24,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top">
							<Path
								x:Name="Ribbon"
								Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=0.9}"
								Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=1.6}"
								Data="M0 0 H16 V27 L8 20 L0 27 Z"
								Fill="{DynamicResource AccentBrush}"
								Stretch="Fill" />
						</Canvas>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="true">
							<Setter TargetName="Band" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
							<Setter TargetName="Rules" Property="Stroke" Value="{DynamicResource AccentBrush}" />
							<Setter TargetName="Ribbon" Property="Fill" Value="{DynamicResource ThreatBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="false">
							<Setter TargetName="Ribbon" Property="Visibility" Value="Collapsed" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>