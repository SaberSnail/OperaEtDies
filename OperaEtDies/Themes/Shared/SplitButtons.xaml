<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:OperaEtDies.Controls"
	xmlns:local="clr-namespace:OperaEtDies"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows">

	<!--  A split button (see SplitButton): the main part is an ordinary button, with its number badge, and the chevron beside
		it opens the menu of other ways. The two share a border, with the outer corners rounded. Without a menu, the main
		part is the whole button. While the main part is disabled, so is the chevron. While the menu is open, the chevron
		ignores the mouse, so clicking it closes the menu rather than opening it again. It keeps its own height, centered in
		a taller row, like the other buttons.  -->
	<Style TargetType="{x:Type controls:SplitButton}">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Padding" Value="8,0" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="local:TemplateHelper.CornerRadius" Value="{DynamicResource ControlBorderRadius}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:SplitButton}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Button
							x:Name="PART_Main"
							Grid.Column="0"
							Padding="{TemplateBinding Padding}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
							local:Hotkeys.Badge="{Binding Action.Badge, RelativeSource={RelativeSource TemplatedParent}}"
							local:TemplateHelper.CornerRadius="{Binding Path=(local:TemplateHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:CornerRadiusSideConverter.Instance}, ConverterParameter=Left}"
							Command="{Binding Action, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}"
							ToolTip="{Binding Action.ToolTip, RelativeSource={RelativeSource TemplatedParent}}"
							ToolTipService.ShowOnDisabled="True">
							<DockPanel>
								<ContentPresenter
									x:Name="LeadingPresenter"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Content="{TemplateBinding Leading}"
									DockPanel.Dock="Left" />
								<TextBlock
									VerticalAlignment="Center"
									Text="{Binding Action.Text, RelativeSource={RelativeSource TemplatedParent}}"
									TextTrimming="CharacterEllipsis" />
							</DockPanel>
						</Button>
						<ToggleButton
							x:Name="PART_Chevron"
							Grid.Column="1"
							Margin="-1,0,0,0"
							Padding="4,0"
							local:TemplateHelper.CornerRadius="{Binding Path=(local:TemplateHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:CornerRadiusSideConverter.Instance}, ConverterParameter=Right}"
							IsChecked="{Binding Action.IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
							IsEnabled="{Binding IsEnabled, ElementName=PART_Main}"
							IsHitTestVisible="{Binding Action.IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static utility:CommonConverters.BooleanNot}}"
							ToolTip="{Binding Action.MenuToolTip, RelativeSource={RelativeSource TemplatedParent}}">
							<Viewbox
								Width="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=0.9}"
								Height="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=0.9}"
								Margin="4,0">
								<Canvas Width="24" Height="24">
									<Path
										Data="{DynamicResource ChevronDownIcon}"
										Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
										StrokeEndLineCap="Round"
										StrokeLineJoin="Round"
										StrokeStartLineCap="Round"
										StrokeThickness="2" />
								</Canvas>
							</Viewbox>
						</ToggleButton>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="Leading" Value="{x:Null}">
							<Setter TargetName="LeadingPresenter" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="HasMenu" Value="False">
							<Setter TargetName="PART_Chevron" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_Main" Property="local:TemplateHelper.CornerRadius" Value="{Binding Path=(local:TemplateHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  A choice in a split button's menu, with the number key that chooses it while the menu is open at its right end. One
		that can't be chosen now is drawn disabled, and still shows its tooltip, which says why.  -->
	<Style x:Key="SplitButtonMenuItemStyle" TargetType="{x:Type MenuItem}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisualStyle}" />
		<Setter Property="Header" Value="{Binding Text}" />
		<Setter Property="InputGestureText" Value="{Binding Badge}" />
		<Setter Property="Command" Value="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Do}" />
		<Setter Property="ToolTip" Value="{Binding ToolTip}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type MenuItem}">
					<Border
						x:Name="Border"
						Padding="8,4"
						Background="Transparent"
						CornerRadius="{DynamicResource ControlBorderRadius}"
						TextBlock.Foreground="{DynamicResource TextBrush}">
						<DockPanel>
							<Border
								x:Name="Badge"
								Margin="12,0,0,0"
								Padding="4,0"
								VerticalAlignment="Center"
								BorderBrush="{DynamicResource RuleBrush}"
								BorderThickness="1"
								CornerRadius="2"
								DockPanel.Dock="Right">
								<TextBlock
									x:Name="BadgeText"
									FontSize="{DynamicResource CaptionFontSize}"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{TemplateBinding InputGestureText}" />
							</Border>
							<ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
						</DockPanel>
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="InputGestureText" Value="">
							<Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="InputGestureText" Value="{x:Null}">
							<Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
						</Trigger>

						<Trigger Property="IsHighlighted" Value="true">
							<Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="false">
							<Setter TargetName="Border" Property="TextBlock.Foreground" Value="{DynamicResource TextDisabledBrush}" />
							<Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource TextDisabledBrush}" />
							<Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  The menu of a split button: the other ways, on a panel with a strong rule around it, wrapping at about the width of a
		tooltip. The arrow keys move through it, and Esc closes it.  -->
	<Style x:Key="SplitButtonMenuStyle" TargetType="{x:Type ContextMenu}">
		<Setter Property="OverridesDefaultStyle" Value="true" />
		<Setter Property="HasDropShadow" Value="False" />
		<Setter Property="FontFamily" Value="{DynamicResource InterfaceFontFamily}" />
		<Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		<Setter Property="MaxWidth" Value="{Binding Path=FontSize, RelativeSource={RelativeSource Self}, Converter={x:Static local:EmConverter.Instance}, ConverterParameter=26}" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource SplitButtonMenuItemStyle}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ContextMenu}">
					<Border
						Padding="2"
						Background="{DynamicResource PanelBrush}"
						BorderBrush="{DynamicResource RuleStrongBrush}"
						BorderThickness="{DynamicResource ControlBorderThickness}"
						CornerRadius="{DynamicResource ControlBorderRadius}">
						<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
