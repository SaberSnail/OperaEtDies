<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:system="clr-namespace:System;assembly=mscorlib">

	<!--
		The theme resources, named by the role they play. The theme in the data replaces them (see ThemeResources), so these
		values are only the built-in theme, used when the data has no theme or it fails to load. Each color in ThemeColors
		has a Color and a Brush here, named after it.
	-->

	<!--  Surfaces  -->
	<Color x:Key="SurfaceColor">#EFE4CC</Color>
	<Color x:Key="PanelColor">#F4EBD7</Color>
	<Color x:Key="ChromeColor">#E2D2AE</Color>
	<Color x:Key="InsetColor">#E6D9BC</Color>
	<Color x:Key="TrackColor">#DCCBA6</Color>
	<Color x:Key="MeterColor">#6B5434</Color>
	<Color x:Key="SunColor">#B07A1E</Color>

	<SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
	<SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
	<SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
	<SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
	<SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
	<SolidColorBrush x:Key="MeterBrush" Color="{StaticResource MeterColor}" />
	<SolidColorBrush x:Key="SunBrush" Color="{StaticResource SunColor}" />

	<!--  Text  -->
	<Color x:Key="TextColor">#2B2118</Color>
	<Color x:Key="TextMutedColor">#6E5A3E</Color>
	<Color x:Key="TextDisabledColor">#A8977A</Color>
	<Color x:Key="TextOnDarkColor">#F4EBD7</Color>
	<Color x:Key="TextOnAccentColor">#F7EFDD</Color>

	<SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
	<SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
	<SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
	<SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />
	<SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

	<!--  Rules, accents, and warnings  -->
	<Color x:Key="RuleColor">#B49A6E</Color>
	<Color x:Key="RuleStrongColor">#8B7350</Color>
	<Color x:Key="AccentColor">#8E1B22</Color>
	<Color x:Key="ThreatColor">#B0301C</Color>

	<SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />
	<SolidColorBrush x:Key="RuleStrongBrush" Color="{StaticResource RuleStrongColor}" />
	<SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
	<SolidColorBrush x:Key="ThreatBrush" Color="{StaticResource ThreatColor}" />

	<!--  Controls  -->
	<Color x:Key="ControlColor">#F7EFDD</Color>
	<Color x:Key="ControlHoverColor">#EADBB8</Color>
	<Color x:Key="ControlPressedColor">#D3BF94</Color>
	<Color x:Key="ControlDisabledColor">#EDE4CF</Color>

	<SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
	<SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
	<SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
	<SolidColorBrush x:Key="ControlDisabledBrush" Color="{StaticResource ControlDisabledColor}" />

	<!--  The map: village, outskirts, and landmark quarters, their borders, the player's quarter, the paths, the river, and areas.  -->
	<Color x:Key="MapVillageColor">#F3E6C8</Color>
	<Color x:Key="MapOutskirtsColor">#D9E2BF</Color>
	<Color x:Key="MapLandmarkColor">#E2D2D8</Color>
	<Color x:Key="MapBorderColor">#8A7458</Color>
	<Color x:Key="MapCurrentColor">#8E1B22</Color>
	<Color x:Key="MapPathColor">#9C5A3A</Color>
	<Color x:Key="MapRiverColor">#8FAFC8</Color>
	<Color x:Key="MapAreaColor">#A9BC8E</Color>

	<SolidColorBrush x:Key="MapVillageBrush" Color="{StaticResource MapVillageColor}" />
	<SolidColorBrush x:Key="MapOutskirtsBrush" Color="{StaticResource MapOutskirtsColor}" />
	<SolidColorBrush x:Key="MapLandmarkBrush" Color="{StaticResource MapLandmarkColor}" />
	<SolidColorBrush x:Key="MapBorderBrush" Color="{StaticResource MapBorderColor}" />
	<SolidColorBrush x:Key="MapCurrentBrush" Color="{StaticResource MapCurrentColor}" />
	<SolidColorBrush x:Key="MapPathBrush" Color="{StaticResource MapPathColor}" />
	<SolidColorBrush x:Key="MapRiverBrush" Color="{StaticResource MapRiverColor}" />
	<SolidColorBrush x:Key="MapAreaBrush" Color="{StaticResource MapAreaColor}" />

	<!--  Fonts, by role: the game's story, and everything else.  -->
	<FontFamily x:Key="NarrativeFontFamily">Palatino Linotype, Georgia</FontFamily>
	<FontFamily x:Key="InterfaceFontFamily">Palatino Linotype, Georgia</FontFamily>

	<!--  Text sizes. Ordinary text is DefaultFontSize, and the others are multiples of it.  -->
	<system:Double x:Key="DefaultFontSize">16</system:Double>
	<system:Double x:Key="SmallFontSize">13.6</system:Double>
	<system:Double x:Key="LargeFontSize">18.4</system:Double>
	<system:Double x:Key="TitleFontSize">28</system:Double>
	<system:Double x:Key="CaptionFontSize">12</system:Double>

	<!--  Developer UI, shown with the developer command line option. Not part of the theme, so it's the same in every theme. A
		strong blue that no theme uses, so it stands out, with a faint wash of it behind.  -->
	<SolidColorBrush x:Key="DeveloperBorderBrush" Color="#2F7CF6" />
	<SolidColorBrush x:Key="DeveloperBackgroundBrush" Color="#142F7CF6" />

	<!--  Control shapes  -->
	<Thickness
		x:Key="ControlBorderThickness"
		Bottom="1"
		Left="1"
		Right="1"
		Top="1" />
	<Thickness
		x:Key="ControlBorderLeftRightThickness"
		Left="1"
		Right="1" />
	<Thickness x:Key="ControlBorderLeftThickness" Left="1" />
	<CornerRadius
		x:Key="ControlBorderRadius"
		BottomLeft="4"
		BottomRight="4"
		TopLeft="4"
		TopRight="4" />

</ResourceDictionary>
