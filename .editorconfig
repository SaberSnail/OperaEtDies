root = true

[*]
end_of_line = crlf

[*.cs]
# Namespaces must match the folder structure.
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error

# ---- Code quality (CA) rules ----

# Specify culture / format provider (parsing and formatting must not depend on the PC's region settings).
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error

# Specify string comparison.
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error

# Cache and reuse JsonSerializerOptions instances.
dotnet_diagnostic.CA1869.severity = error

# Mark members that don't use instance state as static.
dotnet_diagnostic.CA1822.severity = error

# Seal internal types that have no subclasses.
dotnet_diagnostic.CA1852.severity = error

# Dispose objects; types owning disposable fields must be disposable.
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA1001.severity = error

# Don't catch general exceptions.
dotnet_diagnostic.CA1031.severity = error

# Don't expose List<T> or return arrays from properties (checked on all types, not just public ones).
dotnet_diagnostic.CA1002.severity = error
dotnet_diagnostic.CA1819.severity = error
dotnet_code_quality.CA1002.api_surface = all
dotnet_code_quality.CA1819.api_surface = all

# Use throw helpers (ArgumentNullException.ThrowIfNull, etc.).
dotnet_diagnostic.CA1510.severity = error
dotnet_diagnostic.CA1511.severity = error
dotnet_diagnostic.CA1512.severity = error
dotnet_diagnostic.CA1513.severity = error

# Prefer cheaper collection members (Count/Length over LINQ Count()/Any()).
dotnet_diagnostic.CA1826.severity = error
dotnet_diagnostic.CA1829.severity = error
dotnet_diagnostic.CA1860.severity = error

# Forward CancellationToken to methods that accept one.
dotnet_diagnostic.CA2016.severity = error

# ---- Code style (IDE) rules ----

# Make fields readonly when they are never reassigned.
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0044.severity = error

# Remove unused private members.
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error

# Remove unnecessary value assignments and unused parameters.
csharp_style_unused_value_assignment_preference = discard_variable
csharp_style_unused_value_expression_statement_preference = discard_variable
dotnet_code_quality_unused_parameters = all
dotnet_diagnostic.IDE0059.severity = error
dotnet_diagnostic.IDE0060.severity = error

# Use file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = error

# Require explicit accessibility modifiers.
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = error
