<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:model="clr-namespace:ModEditor.Model"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows"
	xmlns:viewModels="clr-namespace:ModEditor.ViewModels">

	<FontFamily x:Key="CodeFontFamily">Consolas</FontFamily>
	<SolidColorBrush x:Key="ErrorBrush" Color="#B02020" />
	<SolidColorBrush x:Key="DetailBrush" Color="#808080" />
	<SolidColorBrush x:Key="AddedBrush" Color="#2E7D32" />
	<SolidColorBrush x:Key="ChangedBrush" Color="#C06000" />

	<Style x:Key="SmallButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
		<Setter Property="Margin" Value="0,0,4,0" />
		<Setter Property="Padding" Value="8,2" />
		<Setter Property="MinHeight" Value="24" />
	</Style>

	<!--  The menu of every folder, file, and piece of the mod. Commands that don't apply to the item are turned off.  -->
	<ContextMenu x:Key="ModNodeMenu" x:Shared="False">
		<MenuItem Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewDataFile}" Header="New Data File…" />
		<MenuItem Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewOperationsFile}" Header="New Operations File…" />
		<MenuItem Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewFolder}" Header="New Folder…" />
		<Separator />
		<MenuItem Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddSection}" Header="Add Section…" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddItem}"
			Header="Add Item"
			InputGestureText="Ins" />
		<Separator />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Cut}"
			Header="Cut"
			InputGestureText="Ctrl+X" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Copy}"
			Header="Copy"
			InputGestureText="Ctrl+C" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Paste}"
			Header="Paste"
			InputGestureText="Ctrl+V" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Duplicate}"
			Header="Duplicate"
			InputGestureText="Ctrl+D" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Rename}"
			Header="Rename…"
			InputGestureText="F2" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Delete}"
			Header="Delete"
			InputGestureText="Del" />
		<Separator />
		<MenuItem Header="Move To" ItemsSource="{Binding Host.MoveTargets}">
			<MenuItem.ItemContainerStyle>
				<Style TargetType="MenuItem">
					<Setter Property="Header" Value="{Binding Path}" />
					<Setter Property="Command" Value="{Binding Command}" />
				</Style>
			</MenuItem.ItemContainerStyle>
		</MenuItem>
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveUp}"
			Header="Move Up"
			InputGestureText="Alt+Up" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveDown}"
			Header="Move Down"
			InputGestureText="Alt+Down" />
		<Separator />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CopyPath}"
			Header="Copy Path"
			InputGestureText="Ctrl+Shift+C" />
		<Separator />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowSelectionHelp}"
			Header="Help"
			InputGestureText="F1" />
	</ContextMenu>

	<!--  The menu of every piece of the game data, which can be replaced or removed by the mod, or copied.  -->
	<ContextMenu x:Key="GameDataNodeMenu" x:Shared="False">
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Replace}"
			FontWeight="SemiBold"
			Header="Replace" />
		<MenuItem Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Remove}" Header="Remove" />
		<MenuItem Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=GoToModChange}" Header="Go to Change in Mod" />
		<Separator />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Copy}"
			Header="Copy"
			InputGestureText="Ctrl+C" />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CopyPath}"
			Header="Copy Path"
			InputGestureText="Ctrl+Shift+C" />
		<Separator />
		<MenuItem
			Command="{Binding Host, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowSelectionHelp}"
			Header="Help"
			InputGestureText="F1" />
	</ContextMenu>

	<!--
		An item's symbol, title, and detail. Folders and files are bold, and items with problems are red. What the mod does
		to a piece of the game data is marked before its title (✚ added, ✎ changed, ✖ removed, struck through), and a ⚠
		after it has something to look at, such as an operation that changes nothing.
	-->
	<DataTemplate x:Key="NodeHeaderTemplate">
		<StackPanel Margin="0,1" Orientation="Horizontal">
			<TextBlock
				Width="20"
				VerticalAlignment="Center"
				FontFamily="Segoe UI Emoji"
				Text="{Binding Glyph}" />
			<TextBlock
				VerticalAlignment="Center"
				FontWeight="Bold"
				Text="{Binding ChangeGlyph}"
				ToolTip="{Binding ChangeText}">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Margin" Value="0,0,4,0" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding Change}" Value="{x:Null}">
								<Setter Property="Margin" Value="0" />
							</DataTrigger>
							<DataTrigger Binding="{Binding Change}" Value="{x:Static model:ChangeKind.Added}">
								<Setter Property="Foreground" Value="{StaticResource AddedBrush}" />
							</DataTrigger>
							<DataTrigger Binding="{Binding Change}" Value="{x:Static model:ChangeKind.Changed}">
								<Setter Property="Foreground" Value="{StaticResource ChangedBrush}" />
							</DataTrigger>
							<DataTrigger Binding="{Binding Change}" Value="{x:Static model:ChangeKind.Removed}">
								<Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
			<TextBlock
				VerticalAlignment="Center"
				Text="{Binding Title}"
				ToolTip="{Binding ChangeText}">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsContainer}" Value="True">
								<Setter Property="FontWeight" Value="SemiBold" />
							</DataTrigger>
							<DataTrigger Binding="{Binding HasProblems}" Value="True">
								<Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
							</DataTrigger>
							<DataTrigger Binding="{Binding Change}" Value="{x:Static model:ChangeKind.Added}">
								<Setter Property="Foreground" Value="{StaticResource AddedBrush}" />
							</DataTrigger>
							<DataTrigger Binding="{Binding Change}" Value="{x:Static model:ChangeKind.Removed}">
								<Setter Property="TextDecorations" Value="Strikethrough" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
			<TextBlock
				Margin="8,0,0,0"
				VerticalAlignment="Center"
				Foreground="{StaticResource DetailBrush}"
				Text="{Binding Detail}"
				TextTrimming="CharacterEllipsis" />
			<TextBlock
				Margin="6,0,0,0"
				VerticalAlignment="Center"
				Foreground="{StaticResource ChangedBrush}"
				Text="⚠"
				ToolTip="{Binding Warning}"
				Visibility="{Binding Warning, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
		</StackPanel>
	</DataTemplate>

	<HierarchicalDataTemplate DataType="{x:Type viewModels:ModNodeViewModel}" ItemsSource="{Binding Children}">
		<ContentPresenter
			Content="{Binding}"
			ContentTemplate="{StaticResource NodeHeaderTemplate}"
			ContextMenu="{StaticResource ModNodeMenu}" />
	</HierarchicalDataTemplate>

	<HierarchicalDataTemplate DataType="{x:Type viewModels:GameDataNodeViewModel}" ItemsSource="{Binding Children}">
		<ContentPresenter
			Content="{Binding}"
			ContentTemplate="{StaticResource NodeHeaderTemplate}"
			ContextMenu="{StaticResource GameDataNodeMenu}" />
	</HierarchicalDataTemplate>

	<Style x:Key="NodeTreeViewItemStyle" TargetType="TreeViewItem">
		<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
		<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
		<Setter Property="Visibility" Value="{Binding IsVisible, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
	</Style>

</ResourceDictionary>
