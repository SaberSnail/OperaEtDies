<Window
	x:Class="ModEditor.Views.Help.HelpWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Mod Editor Help"
	Width="1000"
	Height="800"
	MinWidth="500"
	MinHeight="300"
	Background="{DynamicResource WindowBackgroundBrush}"
	FontSize="{DynamicResource DefaultFontSize}"
	Foreground="{DynamicResource FontBrush}"
	Icon="/Icon.ico"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240" MinWidth="140" />
			<ColumnDefinition Width="6" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  The documents, and the headings of the one shown. Choosing a heading goes to it.  -->
		<DockPanel Grid.Column="0">
			<ListBox
				x:Name="DocumentList"
				Margin="0,0,0,8"
				DisplayMemberPath="Title"
				DockPanel.Dock="Top"
				SelectionChanged="OnDocumentSelectionChanged" />
			<ListBox x:Name="HeadingList" SelectionChanged="OnHeadingSelectionChanged">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Level}" Value="2">
											<Setter Property="FontWeight" Value="SemiBold" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Level}" Value="3">
											<Setter Property="Margin" Value="8,0,0,0" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Level}" Value="4">
											<Setter Property="Margin" Value="16,0,0,0" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Level}" Value="5">
											<Setter Property="Margin" Value="24,0,0,0" />
											<Setter Property="Foreground" Value="{DynamicResource FontLightBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<GridSplitter
			Grid.Column="1"
			Width="6"
			HorizontalAlignment="Stretch"
			Background="Transparent" />

		<!--  The document. Ctrl+F searches it.  -->
		<FlowDocumentReader
			x:Name="Reader"
			Grid.Column="2"
			IsPageViewEnabled="False"
			IsTwoPageViewEnabled="False"
			ViewingMode="Scroll" />
	</Grid>
</Window>
