<Window
	x:Class="ModEditor.Views.Help.HelpWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:utilityControls="clr-namespace:GoldenAnvil.Utility.Windows.Controls;assembly=GoldenAnvil.Utility.Windows"
	Title="Mod Editor Help"
	Width="1000"
	Height="800"
	MinWidth="500"
	MinHeight="300"
	Background="{DynamicResource SurfaceBrush}"
	FontSize="{DynamicResource DefaultFontSize}"
	Foreground="{DynamicResource TextBrush}"
	Icon="pack://application:,,,/ModEditor;component/Icon.ico"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240" MinWidth="140" />
			<ColumnDefinition Width="6" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  The documents, and the headings of the one shown. Choosing a heading goes to it.  -->
		<DockPanel Grid.Column="0">
			<ListBox
				x:Name="DocumentList"
				Margin="0,0,0,8"
				DisplayMemberPath="Title"
				DockPanel.Dock="Top"
				SelectionChanged="OnDocumentSelectionChanged" />
			<ListBox x:Name="HeadingList" SelectionChanged="OnHeadingSelectionChanged">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Level}" Value="2">
											<Setter Property="FontWeight" Value="SemiBold" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Level}" Value="3">
											<Setter Property="Margin" Value="8,0,0,0" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Level}" Value="4">
											<Setter Property="Margin" Value="16,0,0,0" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Level}" Value="5">
											<Setter Property="Margin" Value="24,0,0,0" />
											<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<GridSplitter
			Grid.Column="1"
			Width="6"
			HorizontalAlignment="Stretch"
			Background="Transparent" />

		<!--  The document, at the usual text size, and a box for searching it (Ctrl+F; Enter or F3 finds the next match).  -->
		<DockPanel Grid.Column="2">
			<DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
				<Button
					Margin="4,0,0,0"
					Padding="8,2"
					Click="OnFindNextClick"
					Content="Find Next"
					DockPanel.Dock="Right" />
				<utilityControls:CustomTextBox
					x:Name="FindBox"
					HintText="Find in this document (Ctrl+F)"
					KeyDown="OnFindBoxKeyDown" />
			</DockPanel>
			<TextBlock
				x:Name="FindStatus"
				Margin="0,0,0,4"
				DockPanel.Dock="Bottom"
				Foreground="{DynamicResource TextMutedBrush}" />
			<FlowDocumentScrollViewer
				x:Name="Reader"
				Background="White"
				IsToolBarVisible="False"
				VerticalScrollBarVisibility="Auto" />
		</DockPanel>
	</Grid>
</Window>
