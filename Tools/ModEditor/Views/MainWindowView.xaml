<Window
	x:Class="ModEditor.Views.MainWindowView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:model="clr-namespace:ModEditor.Model"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows"
	xmlns:utilityControls="clr-namespace:GoldenAnvil.Utility.Windows.Controls;assembly=GoldenAnvil.Utility.Windows"
	Title="{Binding Title}"
	Width="1400"
	Height="900"
	MinWidth="700"
	MinHeight="400"
	Background="{DynamicResource WindowBackgroundBrush}"
	FontSize="{DynamicResource DefaultFontSize}"
	Foreground="{DynamicResource FontBrush}"
	Icon="pack://application:,,,/ModEditor;component/Icon.ico"
	WindowStartupLocation="CenterScreen">

	<Window.InputBindings>
		<KeyBinding
			Key="O"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenFolder}"
			Modifiers="Ctrl" />
		<KeyBinding
			Key="S"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Save}"
			Modifiers="Ctrl" />
		<KeyBinding
			Key="Z"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Undo}"
			Modifiers="Ctrl" />
		<KeyBinding
			Key="Y"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Redo}"
			Modifiers="Ctrl" />
		<KeyBinding
			Key="F5"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Reload}" />
		<KeyBinding
			Key="R"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RunGame}"
			Modifiers="Ctrl" />
	</Window.InputBindings>

	<Grid>
		<DockPanel>
			<!--  Toolbar  -->
			<DockPanel Margin="8,6" DockPanel.Dock="Top">
				<StackPanel Orientation="Horizontal">
					<Button
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenFolder}"
						Content="Open…"
						Style="{StaticResource SmallButtonStyle}"
						ToolTip="Open a mod folder (Ctrl+O)" />
					<Button
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Save}"
						Content="Save"
						Style="{StaticResource SmallButtonStyle}"
						ToolTip="Save the changes to the mod folder (Ctrl+S)" />
					<Button
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Reload}"
						Content="Reload"
						Style="{StaticResource SmallButtonStyle}"
						ToolTip="Load the mod folder and the game data again (F5)" />
					<Button
						Margin="12,0,4,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Undo}"
						Content="Undo"
						Style="{StaticResource SmallButtonStyle}"
						ToolTip="Undo (Ctrl+Z)" />
					<Button
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Redo}"
						Content="Redo"
						Style="{StaticResource SmallButtonStyle}"
						ToolTip="Redo (Ctrl+Y)" />
					<Button
						Margin="12,0,4,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RunGame}"
						Content="▶ Run Game"
						Style="{StaticResource SmallButtonStyle}"
						ToolTip="Save the mod, then start the game with only this mod loaded (Ctrl+R)" />
					<CheckBox
						Margin="4,0,0,0"
						VerticalAlignment="Center"
						Content="Developer mode"
						IsChecked="{Binding RunAsDeveloper}"
						ToolTip="Start the game with --developer" />
				</StackPanel>
				<Button
					Margin="12,0,0,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowHelp}"
					Content="?"
					DockPanel.Dock="Right"
					FontWeight="Bold"
					Style="{StaticResource SmallButtonStyle}"
					ToolTip="Help: the editor, mods, and the data files (F1 shows the help about what's selected)" />
				<TextBlock
					Margin="12,0,0,0"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					Foreground="{StaticResource ErrorBrush}"
					Text="{Binding StatusText}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding StatusText}" />
			</DockPanel>

			<!--  Start: no mod is opened until the user chooses one.  -->
			<Grid Visibility="{Binding IsProjectOpen, Converter={x:Static utility:CommonConverters.BooleanNotToVisibility}}">
				<StackPanel
					Width="520"
					Margin="0,60,0,0"
					HorizontalAlignment="Center"
					VerticalAlignment="Top">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="{DynamicResource TitleFontSize}"
						Text="Mod Editor" />
					<TextBlock
						Margin="0,12,0,0"
						HorizontalAlignment="Center"
						Foreground="{DynamicResource FontLightBrush}"
						Text="Open a mod folder to edit it. An empty folder starts a new mod."
						TextWrapping="Wrap" />
					<Button
						Width="200"
						Height="32"
						Margin="0,20,0,0"
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenFolder}"
						Content="Open Mod Folder…" />
					<TextBlock
						Margin="0,28,0,6"
						FontWeight="SemiBold"
						Text="Recent">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Style.Triggers>
									<DataTrigger Binding="{Binding RecentFolders.Count}" Value="0">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<ItemsControl ItemsSource="{Binding RecentFolders}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<DockPanel Margin="0,0,0,4">
									<Button
										Command="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=RemoveRecentFolder}"
										CommandParameter="{Binding}"
										Content="✕"
										DockPanel.Dock="Right"
										Style="{StaticResource SmallButtonStyle}"
										ToolTip="Remove from this list" />
									<Button
										HorizontalContentAlignment="Left"
										Command="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=OpenRecentFolder}"
										CommandParameter="{Binding}"
										Style="{StaticResource SmallButtonStyle}"
										ToolTip="{Binding}">
										<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
									</Button>
								</DockPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Grid>

			<!--  The mod  -->
			<DockPanel Visibility="{Binding IsProjectOpen, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
				<!--
					Shown when the mod's files change on disk while there are changes here. It's at the bottom of the window, below
					the problems, so showing it doesn't move anything at the top.
				-->
				<Border
					Margin="8,0,8,6"
					Padding="8,4"
					Background="#FFF2C0"
					CornerRadius="3"
					DockPanel.Dock="Bottom"
					Visibility="{Binding IsDiskChangePending, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
					<DockPanel>
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ReloadFromDisk}"
								Content="Load and discard my changes"
								Style="{StaticResource SmallButtonStyle}" />
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=DismissDiskChange}"
								Content="Keep my changes"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Saving then only writes the files changed here, keeping the other changes on disk" />
						</StackPanel>
						<TextBlock
							VerticalAlignment="Center"
							Text="The mod's files changed on disk. Loading them again discards your unsaved changes here."
							TextWrapping="Wrap" />
					</DockPanel>
				</Border>

				<!--  Problems found when the game data is loaded with the mod. Double-click one to go to its file.  -->
				<Expander
					Margin="8,4,8,6"
					DockPanel.Dock="Bottom"
					IsExpanded="True">
					<Expander.Header>
						<TextBlock Text="{Binding ProblemSummary}" />
					</Expander.Header>
					<ListBox
						x:Name="ProblemList"
						Height="140"
						FontFamily="{StaticResource CodeFontFamily}"
						ItemsSource="{Binding Problems}"
						MouseDoubleClick="OnProblemDoubleClick"
						PreviewMouseRightButtonDown="OnProblemPreviewMouseRightButtonDown"
						SelectionMode="Extended">
						<ListBox.InputBindings>
							<KeyBinding
								Key="C"
								Command="ApplicationCommands.Copy"
								Modifiers="Ctrl" />
						</ListBox.InputBindings>
						<ListBox.CommandBindings>
							<CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyProblemsExecuted" />
						</ListBox.CommandBindings>
						<!--  Right-clicking a problem selects it (unless it's one of several selected), and its menu copies them.  -->
						<ListBox.ContextMenu>
							<ContextMenu>
								<MenuItem
									Click="OnCopyProblemsClick"
									Header="Copy"
									InputGestureText="Ctrl+C" />
								<MenuItem Click="OnCopyAllProblemsClick" Header="Copy All" />
							</ContextMenu>
						</ListBox.ContextMenu>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock TextWrapping="Wrap">
									<Run FontWeight="Bold" Text="{Binding Location, Mode=OneWay}" />
									<Run Text="{Binding Message, Mode=OneWay}" />
								</TextBlock>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Expander>

				<Grid Margin="8,0,8,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition x:Name="TreeColumn" Width="380" MinWidth="220" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="*" MinWidth="300" />
					</Grid.ColumnDefinitions>

					<!--  The trees  -->
					<DockPanel Grid.Column="0">
						<utilityControls:CustomTextBox
							x:Name="FilterBox"
							Margin="0,0,0,4"
							DockPanel.Dock="Top"
							HintText="Filter (Ctrl+F)"
							Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
						<TabControl SelectedIndex="{Binding TreeTab}">
							<TabItem Header="Mod">
								<DockPanel>
									<WrapPanel Margin="0,4,0,4" DockPanel.Dock="Top">
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewDataFile}"
											Content="+ Data File"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Add a file of sections, merged like a data file, to the selected folder" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewOperationsFile}"
											Content="+ Operations File"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Add a file of operations that change the data to the selected folder" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=NewFolder}"
											Content="+ Folder"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Add a folder to the selected folder" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddSection}"
											Content="+ Section"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Add a section to the selected data file" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddItem}"
											Content="+ Item"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Add an item, setting, or operation after the selected one (Ins)" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddGroup}"
											Content="+ Group"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Add a group of operations, with comments saying what they're for, after the selected operation or group" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveUp}"
											Content="▲"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Move up (Alt+Up)" />
										<Button
											Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveDown}"
											Content="▼"
											Style="{StaticResource SmallButtonStyle}"
											ToolTip="Move down (Alt+Down)" />
									</WrapPanel>
									<TreeView
										x:Name="ModTree"
										AllowDrop="True"
										DragLeave="OnTreeDragLeave"
										DragOver="OnTreeDragOver"
										Drop="OnTreeDrop"
										ItemContainerStyle="{StaticResource NodeTreeViewItemStyle}"
										ItemsSource="{Binding ModRoots}"
										PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
										PreviewMouseMove="OnTreePreviewMouseMove"
										PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown"
										TreeViewItem.Selected="OnModTreeItemSelected">
										<TreeView.Resources>
											<Style BasedOn="{StaticResource NodeTreeViewItemStyle}" TargetType="TreeViewItem" />
										</TreeView.Resources>
										<TreeView.InputBindings>
											<KeyBinding
												Key="C"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Copy}"
												Modifiers="Ctrl" />
											<KeyBinding
												Key="C"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CopyPath}"
												Modifiers="Ctrl+Shift" />
											<KeyBinding
												Key="X"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Cut}"
												Modifiers="Ctrl" />
											<KeyBinding
												Key="V"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Paste}"
												Modifiers="Ctrl" />
											<KeyBinding
												Key="D"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Duplicate}"
												Modifiers="Ctrl" />
											<KeyBinding Key="Delete" Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Delete}" />
											<KeyBinding Key="Insert" Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddItem}" />
											<KeyBinding Key="F2" Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Rename}" />
											<KeyBinding
												Key="Up"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveUp}"
												Modifiers="Alt" />
											<KeyBinding
												Key="Down"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveDown}"
												Modifiers="Alt" />
										</TreeView.InputBindings>
									</TreeView>
								</DockPanel>
							</TabItem>
							<TabItem Header="Game Data">
								<DockPanel>
								<CheckBox
									Margin="0,4,0,4"
									Content="Only what the mod changes"
									DockPanel.Dock="Top"
									IsChecked="{Binding IsOnlyChangedShown}"
									ToolTip="Show only what the mod adds, changes, or removes (marked ✚, ✎, and ✖), and the sections they're in" />
									<TreeView
										x:Name="GameDataTree"
										ItemContainerStyle="{StaticResource NodeTreeViewItemStyle}"
										ItemsSource="{Binding GameDataRoots}"
										PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
										PreviewMouseMove="OnTreePreviewMouseMove"
										PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown"
										ToolTip="The game's data as the mod leaves it. Drag a piece onto the mod, or copy it, to change or reuse it.">
										<TreeView.Resources>
											<Style BasedOn="{StaticResource NodeTreeViewItemStyle}" TargetType="TreeViewItem" />
										</TreeView.Resources>
										<TreeView.InputBindings>
											<KeyBinding
												Key="C"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Copy}"
												Modifiers="Ctrl" />
											<KeyBinding
												Key="C"
												Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=CopyPath}"
												Modifiers="Ctrl+Shift" />
										</TreeView.InputBindings>
									</TreeView>
								</DockPanel>
							</TabItem>
						</TabControl>
					</DockPanel>

					<GridSplitter
						Grid.Column="1"
						Width="6"
						HorizontalAlignment="Stretch"
						Background="Transparent" />

					<!--  The selected item, edited in a form or as JSON  -->
					<DockPanel Grid.Column="2">
						<TextBlock
							Margin="0,4,0,4"
							DockPanel.Dock="Top"
							FontWeight="SemiBold"
							Text="{Binding EditorHeading}"
							TextTrimming="CharacterEllipsis" />
						<TabControl SelectedIndex="{Binding EditorTab}">
							<TabItem Header="Form">
								<Grid>
									<DockPanel>
										<!--  A mod file's comments, for the people editing the mod. The game ignores them.  -->
										<StackPanel
											Margin="8,8,8,0"
											DockPanel.Dock="Top"
											Visibility="{Binding IsCommentsShown, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
											<TextBlock
												FontWeight="SemiBold"
												Text="Comments" />
											<TextBlock
												Margin="0,2,0,4"
												Foreground="{DynamicResource FontLightBrush}"
												Text="{Binding CommentsHint}"
												TextWrapping="Wrap" />
											<TextBox
												MinHeight="80"
												MaxHeight="240"
												AcceptsReturn="True"
												IsEnabled="{Binding IsCommentsEnabled}"
												Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
												TextWrapping="Wrap"
												VerticalScrollBarVisibility="Auto" />
										</StackPanel>
										<TextBlock
											Margin="8"
											Foreground="{DynamicResource FontLightBrush}"
											Text="{Binding FormMessage}"
											TextWrapping="Wrap" />
									</DockPanel>
									<DockPanel Visibility="{Binding Form, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
										<!--  Optional properties that aren't set are hidden unless this is checked. It's kept between sessions.  -->
										<CheckBox
											Margin="8,6,8,0"
											HorizontalAlignment="Right"
											Content="Show all properties"
											DockPanel.Dock="Top"
											IsChecked="{Binding ShowAllProperties}"
											ToolTip="Show every property an object can have, including the optional ones that aren't set" />
										<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
											<!--  The game data's pieces can be looked at, but not changed.  -->
											<ContentPresenter
												Margin="8"
												Content="{Binding Form.Root}" />
										</ScrollViewer>
									</DockPanel>
								</Grid>
							</TabItem>
							<TabItem Header="JSON">
								<DockPanel>
									<!--  Always there, so the text box doesn't change size when an error comes and goes.  -->
									<Border
										Height="44"
										Padding="0,4,0,0"
										DockPanel.Dock="Bottom">
										<Grid>
											<TextBlock
												Foreground="{DynamicResource FontLightBrush}"
												Text="Changes apply as you type, once the JSON is valid. Selecting a file edits its whole text."
												TextWrapping="Wrap"
												Visibility="{Binding EditorError, Converter={x:Static utility:CommonConverters.IsNotNullToVisibility}}" />
											<TextBlock
												Foreground="{StaticResource ErrorBrush}"
												Text="{Binding EditorError}"
												TextTrimming="CharacterEllipsis"
												TextWrapping="Wrap"
												ToolTip="{Binding EditorError}" />
										</Grid>
									</Border>
									<TextBox
										x:Name="EditorTextBox"
										AcceptsReturn="True"
										AcceptsTab="True"
										FontFamily="{StaticResource CodeFontFamily}"
										HorizontalScrollBarVisibility="Auto"
										IsReadOnly="{Binding IsEditorReadOnly}"
										Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
										VerticalScrollBarVisibility="Auto" />
								</DockPanel>
							</TabItem>
							<!--
								What the mod changes in the selected piece of the game data (each with the parts of the mod that changed it,
								which go to them in the Mod tab), or what the selected piece of the mod changes.
							-->
							<TabItem Header="Changes">
								<DockPanel>
									<TextBlock
										Margin="4,6,4,6"
										DockPanel.Dock="Top"
										Foreground="{DynamicResource FontLightBrush}"
										Text="{Binding ChangesMessage}"
										TextWrapping="Wrap" />
									<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
										<ItemsControl Margin="4,0,4,8" ItemsSource="{Binding ChangeRows}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border
														Margin="0,0,0,8"
														Padding="0,0,0,8"
														BorderBrush="#D8D0C0"
														BorderThickness="0,0,0,1">
														<StackPanel>
															<TextBlock TextWrapping="Wrap">
																<Run FontWeight="SemiBold" Text="{Binding KindText, Mode=OneWay}">
																	<Run.Style>
																		<Style TargetType="Run">
																			<Setter Property="Foreground" Value="{StaticResource ChangedBrush}" />
																			<Style.Triggers>
																				<DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ChangeKind.Added}">
																					<Setter Property="Foreground" Value="{StaticResource AddedBrush}" />
																				</DataTrigger>
																				<DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ChangeKind.Removed}">
																					<Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
																				</DataTrigger>
																			</Style.Triggers>
																		</Style>
																	</Run.Style>
																</Run>
																<Run FontFamily="{StaticResource CodeFontFamily}" Text="{Binding Path, Mode=OneWay}" />
															</TextBlock>
															<Grid Margin="0,4,0,0">
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="Auto" />
																	<ColumnDefinition Width="*" />
																</Grid.ColumnDefinitions>
																<Grid.RowDefinitions>
																	<RowDefinition Height="Auto" />
																	<RowDefinition Height="Auto" />
																</Grid.RowDefinitions>
																<TextBlock
																	Margin="0,0,8,0"
																	Foreground="{DynamicResource FontLightBrush}"
																	Text="Before"
																	Visibility="{Binding Before, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
																<TextBox
																	Grid.Column="1"
																	Background="Transparent"
																	BorderThickness="0"
																	FontFamily="{StaticResource CodeFontFamily}"
																	IsReadOnly="True"
																	Text="{Binding Before, Mode=OneWay}"
																	TextWrapping="Wrap"
																	Visibility="{Binding Before, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
																<TextBlock
																	Grid.Row="1"
																	Margin="0,0,8,0"
																	Foreground="{DynamicResource FontLightBrush}"
																	Text="After"
																	Visibility="{Binding After, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
																<TextBox
																	Grid.Row="1"
																	Grid.Column="1"
																	Background="Transparent"
																	BorderThickness="0"
																	FontFamily="{StaticResource CodeFontFamily}"
																	IsReadOnly="True"
																	Text="{Binding After, Mode=OneWay}"
																	TextWrapping="Wrap"
																	Visibility="{Binding After, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}" />
															</Grid>
															<!--  The parts of the mod that changed it, in the order they're applied; the last one's value is the one it has.  -->
															<ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Sources}">
																<ItemsControl.ItemTemplate>
																	<DataTemplate>
																		<TextBlock Margin="0,1,0,0">
																			<Run Foreground="{DynamicResource FontLightBrush}" Text="by " />
																			<Hyperlink Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=GoTo}" ToolTip="Go to it in the Mod tab">
																				<Run Text="{Binding Title, Mode=OneWay}" />
																			</Hyperlink>
																		</TextBlock>
																	</DataTemplate>
																</ItemsControl.ItemTemplate>
															</ItemsControl>
														</StackPanel>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
								</DockPanel>
							</TabItem>
						</TabControl>
					</DockPanel>
				</Grid>
			</DockPanel>
		</DockPanel>

	<!--  A message that goes away on its own, over the bottom of the window so it doesn't move anything.  -->
	<Border
		Margin="0,0,24,180"
		Padding="12,6"
		HorizontalAlignment="Right"
		VerticalAlignment="Bottom"
		Background="#F0303030"
		CornerRadius="4"
		IsHitTestVisible="False"
		Visibility="{Binding ToastText, Converter={x:Static utility:CommonConverters.IsNullOrEmptyToVisibility}}">
		<TextBlock Foreground="White" Text="{Binding ToastText}" />
	</Border>
	</Grid>
</Window>
