<Window
	x:Class="PortraitEditor.Views.MainWindowView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PortraitEditor.Controls"
	xmlns:model="clr-namespace:PortraitEditor.Model"
	xmlns:utility="clr-namespace:GoldenAnvil.Utility.Windows;assembly=GoldenAnvil.Utility.Windows"
	xmlns:utilityControls="clr-namespace:GoldenAnvil.Utility.Windows.Controls;assembly=GoldenAnvil.Utility.Windows"
	xmlns:viewModels="clr-namespace:PortraitEditor.ViewModels"
	Title="{Binding Title}"
	Width="1800"
	Height="960"
	Background="{DynamicResource WindowBackgroundBrush}"
	FontSize="{DynamicResource DefaultFontSize}"
	Icon="/Icon.ico"
	Foreground="{DynamicResource FontBrush}"
	WindowStartupLocation="CenterScreen">

	<!--  F1 is the help command's key.  -->
	<Window.CommandBindings>
		<CommandBinding Command="Help" Executed="OnHelpExecuted" />
	</Window.CommandBindings>

	<Window.InputBindings>
		<KeyBinding
			Key="Z"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Undo}"
			Modifiers="Ctrl" />
		<KeyBinding
			Key="Y"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Redo}"
			Modifiers="Ctrl" />
		<KeyBinding
			Key="F5"
			Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Reload}" />
	</Window.InputBindings>

	<DockPanel>
		<!--  Toolbar  -->
		<DockPanel Margin="8,6" DockPanel.Dock="Top">
			<StackPanel Orientation="Horizontal">
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Undo}"
					Content="Undo"
					Style="{StaticResource SmallButtonStyle}"
					ToolTip="Undo (Ctrl+Z)" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Redo}"
					Content="Redo"
					Style="{StaticResource SmallButtonStyle}"
					ToolTip="Redo (Ctrl+Y)" />
				<Button
					Margin="12,0,4,0"
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Reload}"
					Content="Reload"
					Style="{StaticResource SmallButtonStyle}"
					ToolTip="Load the data files again, discarding any edits (F5)" />
				<TextBlock
					Margin="12,0,0,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource FontLightBrush}"
					Text="{Binding DataDescription}" />
			</StackPanel>
			<Button
				Margin="12,0,0,0"
				Click="OnShortcutsClick"
				Content="?"
				DockPanel.Dock="Right"
				FontWeight="Bold"
				Style="{StaticResource SmallButtonStyle}"
				ToolTip="Shortcuts (F1)" />
			<TextBlock
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Foreground="{DynamicResource FontLightBrush}"
				Text="{Binding StatusText}" />
		</DockPanel>

		<!--  Shown when the files change on disk while there are edits.  -->
		<Border
			Padding="8,4"
			Background="#FFF2C0"
			DockPanel.Dock="Top"
			Visibility="{Binding IsDiskChangePending, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}">
			<StackPanel Orientation="Horizontal">
				<TextBlock
					Margin="0,0,12,0"
					VerticalAlignment="Center"
					Text="The data files changed on disk. Reloading them discards your edits (copy anything you want to keep first)." />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=Reload}"
					Content="Reload and discard edits"
					Style="{StaticResource SmallButtonStyle}" />
				<Button
					Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=DismissDiskChange}"
					Content="Keep editing"
					Style="{StaticResource SmallButtonStyle}" />
			</StackPanel>
		</Border>

		<!--  Problems  -->
		<Expander
			Margin="8,4"
			DockPanel.Dock="Bottom"
			IsExpanded="False">
			<Expander.Header>
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="{Binding ProblemSummary}" />
					<TextBlock
						Margin="12,0,0,0"
						Foreground="{StaticResource ErrorBrush}"
						Text="The data can't be read, so the portraits show the last version that could."
						Visibility="{Binding IsStale, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
				</StackPanel>
			</Expander.Header>
			<ListBox
				MaxHeight="180"
				FontFamily="{StaticResource CodeFontFamily}"
				ItemsSource="{Binding Problems}" />
		</Expander>

		<Grid Margin="8,0,8,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="800" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition x:Name="PreviewsColumn" Width="300" MinWidth="160" />
			</Grid.ColumnDefinitions>

			<!--  Each splitter resizes the panel beside it, and the canvas takes up the rest.  -->
			<Grid Grid.Column="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition x:Name="TreeColumn" Width="300" MinWidth="200" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="*" MinWidth="300" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition x:Name="EditorColumn" Width="420" MinWidth="280" />
				</Grid.ColumnDefinitions>

				<!--  The portrait data  -->
				<DockPanel Grid.Column="0">
					<utilityControls:CustomTextBox
						Margin="0,0,0,4"
						DockPanel.Dock="Top"
						HintText="Filter by id"
						Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
					<CheckBox
						Margin="0,0,0,4"
						Content="Only for focused character"
						ToolTip="Only show the layers and shapes drawn for the focused character (or forced on the canvas)"
						DockPanel.Dock="Top"
						IsChecked="{Binding DrawnOnly}" />
					<!--  Shown while any layers or shapes are forced or hidden on the canvas. It's below the tree, so showing it doesn't move anything.  -->
					<Border
						Margin="0,4,0,0"
						Padding="6,2"
						Background="#FFF0C8"
						CornerRadius="3"
						DockPanel.Dock="Bottom"
						Visibility="{Binding CanvasStateSummary, Converter={x:Static utility:CommonConverters.IsNullOrEmptyToVisibility}}">
						<DockPanel>
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ResetCanvasStates}"
								Content="✕"
								DockPanel.Dock="Right"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Put every layer and shape back to normal on the canvas" />
							<TextBlock
								VerticalAlignment="Center"
								Text="{Binding CanvasStateSummary}"
								ToolTip="Layers and shapes forced or hidden on the canvas (not in the previews)" />
						</DockPanel>
					</Border>
					<WrapPanel Margin="0,0,0,4" DockPanel.Dock="Top">
						<Button
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddShape}"
							Content="Add shape"
							Style="{StaticResource SmallButtonStyle}"
							ToolTip="Add a square to the selected layer, after the selected shape" />
						<Button
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddLayer}"
							Content="Add layer"
							Style="{StaticResource SmallButtonStyle}"
							ToolTip="Add a layer with a square in it, after the selected layer (or at the end)" />
						<Button
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveItemUp}"
							Content="▲"
							Style="{StaticResource SmallButtonStyle}"
							ToolTip="Move up (drawn earlier)" />
						<Button
							Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=MoveItemDown}"
							Content="▼"
							Style="{StaticResource SmallButtonStyle}"
							ToolTip="Move down (drawn later)" />
					</WrapPanel>
					<TreeView
						x:Name="DataTree"
						ItemsSource="{Binding TreeRoots}"
						PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown"
						TreeViewItem.Selected="OnTreeViewItemSelected">
						<TreeView.Resources>
							<!--  Items only scroll into view when they're selected, so expanding an item doesn't scroll the tree.  -->
							<Style TargetType="TreeViewItem">
								<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
								<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
								<Setter Property="Visibility" Value="{Binding IsVisible, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
								<EventSetter Event="RequestBringIntoView" Handler="OnTreeViewItemRequestBringIntoView" />
							</Style>
							<HierarchicalDataTemplate DataType="{x:Type viewModels:CategoryItemViewModel}" ItemsSource="{Binding Children}">
								<TextBlock FontWeight="Bold" Text="{Binding Title}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding HasCanvasState}" Value="True">
													<Setter Property="ContextMenu" Value="{StaticResource CanvasStateCategoryMenu}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</HierarchicalDataTemplate>
							<!--  Every item has a menu for duplicating and deleting it. Layers and shapes also have a button for whether they're drawn on the canvas, menu items for setting it, and a tint while forced.  -->
							<HierarchicalDataTemplate DataType="{x:Type viewModels:DataItemViewModel}" ItemsSource="{Binding Children}">
								<StackPanel Orientation="Horizontal">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="ContextMenu" Value="{StaticResource DataItemMenu}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding HasCanvasState}" Value="True">
													<Setter Property="ContextMenu" Value="{StaticResource CanvasStateMenu}" />
												</DataTrigger>
												<DataTrigger Binding="{Binding CanvasState}" Value="{x:Static viewModels:CanvasState.Forced}">
													<Setter Property="Background" Value="#FFF0C8" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>
									<Button
										Click="OnCanvasStateButtonClick"
										Style="{StaticResource CanvasStateButtonStyle}"
										Visibility="{Binding HasCanvasState, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
									<Border
										Margin="0,0,4,0"
										VerticalAlignment="Center"
										Visibility="{Binding Swatch, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
										<ContentPresenter Content="{Binding Swatch}" ContentTemplate="{StaticResource SwatchTemplate}" />
									</Border>
									<TextBlock VerticalAlignment="Center" Text="{Binding Title}">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsDrawn}" Value="False">
														<Setter Property="Foreground" Value="#909090" />
													</DataTrigger>
													<DataTrigger Binding="{Binding IsModified}" Value="True">
														<Setter Property="FontWeight" Value="Bold" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<TextBlock
										Margin="2,0,0,0"
										VerticalAlignment="Center"
										Foreground="#2F7CF6"
										Text="●"
										ToolTip="Edited"
										Visibility="{Binding IsModified, Converter={x:Static utility:CommonConverters.BooleanToVisibility}}" />
								</StackPanel>
							</HierarchicalDataTemplate>
						</TreeView.Resources>
					</TreeView>
				</DockPanel>

				<GridSplitter
					Grid.Column="1"
					HorizontalAlignment="Stretch"
					ResizeBehavior="PreviousAndNext"
					ResizeDirection="Columns" />

				<!--  The canvas  -->
				<DockPanel Grid.Column="2">
					<StackPanel DataContext="{Binding Canvas}" DockPanel.Dock="Top">
						<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ZoomOut}"
								Content="−"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Zoom out" />
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ResetZoom}"
								Content="{Binding Zoom}"
								ContentStringFormat="{}{0:P0}"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Zoom to 100% (Ctrl+wheel zooms)" />
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ZoomIn}"
								Content="+"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Zoom in" />
							<Button
								Click="OnZoomToFitClick"
								Content="Fit"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Zoom so the whole portrait fits" />
							<CheckBox
								Margin="8,0,16,0"
								VerticalAlignment="Center"
								Content="Grid"
								IsChecked="{Binding ShowGrid}" />
							<TextBlock
								VerticalAlignment="Center"
								FontFamily="{StaticResource CodeFontFamily}"
								Foreground="{DynamicResource FontLightBrush}"
								Text="{Binding CursorText}" />
						</StackPanel>
						<!--  Always shown (greyed out without a shape or point), so selecting a shape doesn't move the canvas.  -->
						<WrapPanel Margin="0,0,0,4" IsEnabled="{Binding HasPath}">
							<StackPanel Margin="0,0,0,2" Orientation="Horizontal">
								<TextBlock Style="{StaticResource FieldLabelStyle}" Text="Bounds  X" />
								<utilityControls:CustomTextBox Style="{StaticResource CanvasNumberFieldStyle}" Text="{Binding BoundsX}" />
								<TextBlock Style="{StaticResource FieldLabelStyle}" Text="Y" />
								<utilityControls:CustomTextBox Style="{StaticResource CanvasNumberFieldStyle}" Text="{Binding BoundsY}" />
								<TextBlock Style="{StaticResource FieldLabelStyle}" Text="W" />
								<utilityControls:CustomTextBox Style="{StaticResource CanvasNumberFieldStyle}" Text="{Binding BoundsWidth}" />
								<TextBlock Style="{StaticResource FieldLabelStyle}" Text="H" />
								<utilityControls:CustomTextBox Style="{StaticResource CanvasNumberFieldStyle}" Text="{Binding BoundsHeight}" />
							</StackPanel>
							<StackPanel
								Margin="8,0,0,2"
								Orientation="Horizontal"
								IsEnabled="{Binding HasSelectedPoint}">
								<TextBlock Style="{StaticResource FieldLabelStyle}" Text="Point  X" />
								<utilityControls:CustomTextBox Style="{StaticResource CanvasNumberFieldStyle}" Text="{Binding PointX}" />
								<TextBlock Style="{StaticResource FieldLabelStyle}" Text="Y" />
								<utilityControls:CustomTextBox Style="{StaticResource CanvasNumberFieldStyle}" Text="{Binding PointY}" />
							</StackPanel>
						</WrapPanel>
					</StackPanel>

					<!--  Messages about the selected shape go below the canvas, so showing them doesn't move it.  -->
					<StackPanel DataContext="{Binding Canvas}" DockPanel.Dock="Bottom">
						<TextBlock
							Margin="0,4,0,0"
							Style="{StaticResource ErrorTextStyle}"
							Text="{Binding PathMessage}" />
						<DockPanel Margin="0,4,0,0" Visibility="{Binding NotDrawnMessage, Converter={x:Static utility:CommonConverters.IsNullToVisibility}}">
							<Button
								Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=ShowAnyway}"
								Content="📌 Show anyway"
								DockPanel.Dock="Right"
								Style="{StaticResource SmallButtonStyle}"
								ToolTip="Force this shape to be drawn on the canvas" />
							<TextBlock
								VerticalAlignment="Center"
								Foreground="{StaticResource ErrorBrush}"
								Text="{Binding NotDrawnMessage}"
								TextWrapping="Wrap" />
						</DockPanel>
					</StackPanel>

					<ScrollViewer
						x:Name="CanvasScrollViewer"
						HorizontalScrollBarVisibility="Auto"
						PreviewMouseWheel="OnCanvasPreviewMouseWheel"
						VerticalScrollBarVisibility="Auto">
						<controls:ShapeCanvas DataContext="{Binding Canvas}" />
					</ScrollViewer>
				</DockPanel>

				<GridSplitter
					Grid.Column="3"
					HorizontalAlignment="Stretch"
					ResizeBehavior="PreviousAndNext"
					ResizeDirection="Columns" />

				<!--  The selected item's editor  -->
				<Border
					Grid.Column="4"
					Padding="6"
					Background="{StaticResource PanelBrush}">
					<Grid>
						<ContentControl Content="{Binding ItemEditor}" Focusable="False" />
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="{DynamicResource FontLightBrush}"
							Text="Select an item in the tree, or click a shape in the portrait."
							TextWrapping="Wrap"
							Visibility="{Binding ItemEditor, Converter={x:Static utility:CommonConverters.IsNotNullToVisibility}}" />
					</Grid>
				</Border>
			</Grid>

			<GridSplitter
				Grid.Column="1"
				HorizontalAlignment="Stretch"
				ResizeBehavior="PreviousAndNext"
				ResizeDirection="Columns" />

			<!--  Preview characters, in as many columns as fit  -->
			<DockPanel Grid.Column="2">
				<DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
					<Button
						Command="{Binding Converter={x:Static utility:MethodToCommandConverter.Instance}, ConverterParameter=AddPreview}"
						Content="Add character"
						DockPanel.Dock="Left"
						Style="{StaticResource SmallButtonStyle}" />
					<Slider
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						Maximum="{x:Static model:EditorSettings.MaximumPreviewSize}"
						Minimum="{x:Static model:EditorSettings.MinimumPreviewSize}"
						ToolTip="Portrait size"
						Value="{Binding PreviewSize}" />
				</DockPanel>
				<TextBlock
					Margin="0,0,0,4"
					DockPanel.Dock="Top"
					Foreground="{DynamicResource FontLightBrush}"
					Text="The selected character is shown on the canvas."
					TextWrapping="Wrap" />
				<ListBox
					ItemContainerStyle="{StaticResource PreviewItemStyle}"
					ItemsSource="{Binding Previews}"
					ScrollViewer.CanContentScroll="False"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					SelectedItem="{Binding FocusedPreview}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>
			</DockPanel>
		</Grid>
	</DockPanel>
</Window>
