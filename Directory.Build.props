<Project>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run IDE code-style analyzers (e.g. IDE0130) during build, not just in the editor. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Third-party package safeguards. See "Third-Party Packages" in Docs/Dependencies.md. -->
  <PropertyGroup>
    <!--
      Each project's packages.lock.json records the exact version and content hash of every package it uses, directly or
      not. Restores fail if a package changes or a version would change, so updating one is always deliberate.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <!--
      Packages with known vulnerabilities, of any severity, used directly or not, stop the build (their warnings are
      errors). A restore that can't reach nuget.org to check (NU1900) only warns.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
